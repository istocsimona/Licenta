				// Function to calculate End Time and update the hidden inputs
		function calculateEventTimes() {
			const dateVal = document.getElementById('EventDateUI').value;
			const timeVal = document.getElementById('StartTimeUI').value;
			const durVal = parseFloat(document.getElementById('DurationUI').value) || 0;

			if (!dateVal || !timeVal) return;

			// 1. Create a Javascript Date object for the Start Time
			const startDateTime = new Date(`${dateVal}T${timeVal}`);

			// 2. Add the duration (Hours converted to Milliseconds)
			const endDateTime = new Date(startDateTime.getTime() + durVal * 60 * 60 * 1000);

			// 3. Format helper for C# (yyyy-MM-ddTHH:mm)
			const pad = (n) => n.toString().padStart(2, '0');
			const formatForCSharp = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;

			// 4. Populate the hidden inputs that the Controller expects
			document.getElementById('RealStartDate').value = formatForCSharp(startDateTime);
			document.getElementById('RealEndDate').value = formatForCSharp(endDateTime);

			// 5. Update the visual UI badge for the user
			document.getElementById('EndTimeDisplay').innerText = `${pad(endDateTime.getHours())}:${pad(endDateTime.getMinutes())}`;
		}

		// Attach listeners so the calculation runs automatically when the user types or clicks
		document.getElementById('EventDateUI').addEventListener('input', calculateEventTimes);
		document.getElementById('StartTimeUI').addEventListener('input', calculateEventTimes);
		document.getElementById('DurationUI').addEventListener('input', calculateEventTimes);

				document.getElementById('addEventForm').addEventListener('submit', async function (e) {
