			// 1. Switch to the 'Add New' tab UI
			const addTabTrigger = document.getElementById('pills-add-tab');
			bootstrap.Tab.getOrCreateInstance(addTabTrigger).show();

			// 2. Update the Search Box value visually (Optional but helps user experience)
			const searchBox = document.getElementById('searchBox');
			searchBox.value = feat.properties.name;

			// 3. Manually trigger the logic you wrote in the 'retrieve' listener
			// Instead of dispatching a fake event which often fails due to security/structure,
			// it's cleaner to wrap your 'retrieve' logic in a named function.
			handleLocationSelection(feat);
		}

		function generateTagBadges(props, existingData) {
			const tagBadgesContainer = document.getElementById('tagBadges');
			const tagInputsContainer = document.getElementById('tagInputsContainer');
			tagBadgesContainer.innerHTML = "";
			tagInputsContainer.innerHTML = "";

			const mbCategories = props.poi_category || [];

			// If it's existing, use the tags from DB, otherwise guess from Mapbox categories
			const tagsToDisplay = existingData ? existingData.tags : allSystemTags.filter(sysTag => {
				return mbCategories.some(cat => {
					const nCat = cat.toLowerCase().replace(/_/g, ' ').trim();
					const nSys = sysTag.name.toLowerCase().replace(/_/g, ' ').trim();
					return nCat.includes(nSys) || nSys.includes(nCat);
				});
			});

			tagsToDisplay.forEach(tag => {
				tagBadgesContainer.appendChild(createStylizedBadge(tag.name, tag.color, tag.icon));
				const input = document.createElement('input');
				input.type = "hidden";
				input.name = "SelectedTagIds";
				input.value = tag.tagId;
				tagInputsContainer.appendChild(input);
			});
		}


		let originalValues = {}; // To store values for "Cancel"

		function enterEditMode() {
			const card = document.getElementById('detailsCard');
			const durInput = document.querySelector('input[name="AvgDuration"]');
			const openInput = document.getElementById('OpeningHour');
			const closeInput = document.getElementById('ClosingHour');

			// Save original values in case of cancel
			originalValues = {
				duration: durInput.value,
				opening: openInput.value,
				closing: closeInput.value
			};

			// UI Changes
			card.classList.add('editing-active');
			document.getElementById('btnEnterEdit').style.display = 'none';
			document.getElementById('editActionButtons').style.display = 'flex';

			// Enable Inputs
			durInput.readOnly = false;
			durInput.focus();
			openInput._flatpickr.set('clickOpens', true);
			closeInput._flatpickr.set('clickOpens', true);

			// Optional: add a subtle animation
			card.style.transform = "scale(1.02)";
			setTimeout(() => card.style.transform = "scale(1)", 200);
		}

		function exitEditMode(saveChanges) {
			const card = document.getElementById('detailsCard');
			const durInput = document.querySelector('input[name="AvgDuration"]');
			const openInput = document.getElementById('OpeningHour');
			const closeInput = document.getElementById('ClosingHour');

			if (!saveChanges) {
				// Revert to original values
				durInput.value = originalValues.duration;
				openInput._flatpickr.setDate(originalValues.opening);
				closeInput._flatpickr.setDate(originalValues.closing);
			}

			// UI Changes
			card.classList.remove('editing-active');
			document.getElementById('btnEnterEdit').style.display = 'block';
			document.getElementById('editActionButtons').style.display = 'none';

			// Disable Inputs
			durInput.readOnly = true;
			openInput._flatpickr.set('clickOpens', false);
			closeInput._flatpickr.set('clickOpens', false);
		}

		function handleLocationSelection(feature) {
			if (!feature) return;

			const props = feature.properties;
			const coords = feature.geometry.coordinates;
			const lng = coords[0];
			const lat = coords[1];
			const address = props.full_address || props.place_formatted || "";

			document.getElementById('Name').value = props.name || props.full_address;
			document.getElementById('Longitude').value = lng;
			document.getElementById('Latitude').value = lat;

			const addressInput = document.getElementById('Address');
			if(addressInput) addressInput.value = address;

			// 1. Check if it's already in our database array
			// TIP: Ensure your existingLocations array is being populated correctly in loadExistingPins()
			const existingData = existingLocations.find(loc =>
				Math.abs(loc.latitude - lat) < 0.0001 && Math.abs(loc.longitude - lng) < 0.0001
			);

			document.getElementById('selectedPlaceNameText').innerHTML = `
				${props.name || "Selected Place"}
				<small class="d-block text-muted fw-normal mt-1" style="font-size: 0.8rem;">
					<i class="bi bi-geo-alt"></i> ${address}
				</small>`;

			if (existingData) {
				// --- CASE: IT IS IN YOUR ITINERARY ---
				document.querySelector('input[name="AvgDuration"]').value = existingData.avgDuration;
				document.getElementById('OpeningHour')._flatpickr.setDate(existingData.openingHour || "");
				document.getElementById('ClosingHour')._flatpickr.setDate(existingData.closingHour || "");

				toggleInputsLock(true); // This locks the UI
			} else {
				// --- CASE: IT IS NEW (NOT IN ITINERARY) ---
				toggleInputsLock(false); // <--- THIS IS THE CRITICAL FIX: Unlock for new items

				// Reset to defaults for new places
				const suggestedDuration = getDurationFromCategories(props.poi_category || []);
				document.querySelector('input[name="AvgDuration"]').value = suggestedDuration;
				document.getElementById('OpeningHour')._flatpickr.clear();
				document.getElementById('ClosingHour')._flatpickr.clear();

				document.getElementById('osmStatus').innerHTML = "";
				tryFetchHours(); // Go look for hours on OpenStreetMap
			}

			const eventBanner = document.getElementById('existingEventBanner');
			if (existingData && existingData.eventDetails) {
				const ev = existingData.eventDetails;

				// Format the dates nicely (e.g., "Oct 24, 10:00 - 12:00")
				const start = new Date(ev.startDate);
				const end = new Date(ev.endDate);
				const formattedDate = start.toLocaleDateString([], { month: 'short', day: 'numeric' });
				const formattedTime = `${start.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} - ${end.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;

				eventBanner.innerHTML = `
					<button type="button" class="btn btn-sm text-danger position-absolute top-0 end-0 mt-2 me-2 p-1 border-0 bg-transparent shadow-none" onclick="deleteEvent(${ev.id})">
						<i class="bi bi-trash3-fill fs-5"></i>
					</button>

					<div class="d-flex align-items-center">
						<div class="rounded-circle p-2 me-3" style="background-color: var(--p2); color: var(--p3); display: flex; align-items: center; justify-content: center; width: 40px; height: 40px;">
							<i class="bi bi-calendar-check-fill"></i>
						</div>
						<div class="pe-4"> <h6 class="mb-0 fw-bold" style="color: var(--p5);">${ev.name}</h6>
							<small class="text-muted fw-bold d-block" style="font-size: 0.75rem;">📅 ${formattedDate} <span class="mx-1">•</span> 🕒 ${formattedTime}</small>
						</div>
					</div>
				`;
				eventBanner.style.display = 'block';
			} else {
				eventBanner.style.display = 'none';
			}
			
			
		

			// Map and View logic...
			if (currentMarker) currentMarker.remove();
			if (!existingData) {
				currentMarker = new mapboxgl.Marker({ color: '#79B4A9' }).setLngLat([lng, lat]).addTo(map);
			}
			map.flyTo({ center: [lng, lat], zoom: 15 });
			document.getElementById('empty-state').style.display = 'none';
			document.getElementById('locationForm').style.display = 'block';
			generateTagBadges(props, existingData);
		}

		function getDurationFromCategories(categories) {
			if (!categories || categories.length === 0) return 60; // Default fallback

			let maxDuration = 0;

			categories.forEach(cat => {
				const normalizedCat = cat.toLowerCase().replace(/_/g, ' ');

				// Check if our mapping contains this category string
				for (const [key, minutes] of Object.entries(CATEGORY_DURATIONS)) {
					if (normalizedCat.includes(key)) {
						// If a place has multiple categories (e.g., "Museum" and "Cafe"),
						// we usually want the longer one (the Museum).
						if (minutes > maxDuration) maxDuration = minutes;
					}
				}
			});

			return maxDuration > 0 ? maxDuration : 60;
		}

		async function deleteEvent(eventId) {
			const result = await Swal.fire({
				title: 'Remove Event?',
				text: "This will remove the event from your itinerary.",
				icon: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#79B4A9',
				cancelButtonColor: '#d33',
				confirmButtonText: 'Yes, delete it!'
			});

			if (result.isConfirmed) {
				try {
					// Ensure the URL is correct based on your routing
					const response = await fetch(`/Reservations/AjaxDeleteReservation?id=${eventId}`, {
						method: 'POST',
						headers: {
							'X-Requested-With': 'XMLHttpRequest',
							'Content-Type': 'application/x-www-form-urlencoded'
						}
					});

					const data = await response.json();

					if (data.success) {
						Swal.fire({
							title: 'Deleted!',
							text: 'Event removed.',
							icon: 'success',
							timer: 1500,
							showConfirmButton: false
						});

						document.getElementById('existingEventBanner').style.display = 'none';
						await refreshLocationList();

						// Update local memory so clicking the pin again doesn't show the old event
						const lat = document.getElementById('Latitude').value;
						const lng = document.getElementById('Longitude').value;
						const locIndex = existingLocations.findIndex(l =>
							Math.abs(l.latitude - lat) < 0.0001 && Math.abs(l.longitude - lng) < 0.0001
						);
						if (locIndex !== -1) {
							existingLocations[locIndex].eventDetails = null;
						}
					} else {
						Swal.fire('Error', data.message || 'Could not delete the event.', 'error');
					}
				} catch (e) {
					console.error("Delete Error:", e);
					Swal.fire('Error', 'A network error occurred.', 'error');
				}
			}
		}

		function createSplitPin(colors) {
			const el = document.createElement('div');
			const gradId = "grad_" + Math.random().toString(36).substr(2, 9);
			if (!colors.length) colors = ['#79B4A9'];
			el.innerHTML = `<svg width="32" height="42" viewBox="0 0 32 42"><path d="M16 0C7.1 0 0 7.1 0 16C0 28 16 42 16 42C16 42 32 28 32 16C32 7.1 24.8 0 16 0Z" fill="white"/><path d="M16 2C8.2 2 2 8.2 2 16C2 25.5 16 38.5 16 38.5C30 25.5 30 16 30 16C30 8.2 23.7 2 16 2Z" fill="url(#${gradId})"/><defs><linearGradient id="${gradId}" x1="0%" y1="0%" x2="100%" y2="100%">${colors.map((c, i) => `<stop offset="${(i/colors.length)*100}%" stop-color="${c}"/><stop offset="${((i+1)/colors.length)*100}%" stop-color="${c}"/>`).join('')}</linearGradient></defs></svg>`;
			return el;
		}

				async function loadExistingPins() {
			try {
				const res = await fetch(`/Locations/GetTripLocations?tripId=@Model.TripId`);
				const locs = await res.json();
				existingLocations = locs;

				// Clear existing markers from the map first if re-loading
				Object.values(mapMarkers).forEach(marker => marker.remove());
				mapMarkers = {};

				locs.forEach(l => {
					const colors = l.tags.map(t => t.color);
					const marker = new mapboxgl.Marker({ element: createSplitPin(colors) })
						.setLngLat([l.longitude, l.latitude])
						.addTo(map);

					// Store the marker using its ID
					const id = l.locationId || l.id;
					mapMarkers[id] = marker;

					marker.getElement().addEventListener('click', () => {
						handleLocationSelection({
							geometry: { coordinates: [l.longitude, l.latitude] },
							properties: { name: l.name, full_address: l.address }
						});
					});
				});
			} catch(e) { console.error("Error loading pins:", e); }
		}


		async function tryFetchHours(retries = 3) {
			const lat = document.getElementById('Latitude').value;
			const lon = document.getElementById('Longitude').value;
			const nameInput = document.getElementById('Name').value;
			const statusLabel = document.getElementById('osmStatus');
			if (!lat || !lon || !statusLabel) return;
			statusLabel.innerText = "⏳ Syncing hours...";
			const firstName = nameInput.split(' ')[0].replace(/[^\w\s]/gi, '');
			const query = `[out:json][timeout:15];(node(around:200,${lat},${lon})["opening_hours"];way(around:200,${lat},${lon})["opening_hours"];node["name"~"${firstName}",i](around:500,${lat},${lon}););out tags;`;
			try {
				const response = await fetch("https://overpass-api.de/api/interpreter?data=" + encodeURIComponent(query));
				if (!response.ok && retries > 0) { await new Promise(res => setTimeout(res, 2000)); return tryFetchHours(retries - 1); }
				const data = await response.json();
				const element = data.elements.find(el => el.tags && el.tags.opening_hours);
				if (element) {
					const match = element.tags.opening_hours.match(/([0-1]?\d|2[0-3]):([0-5]\d)\s?-\s?([0-1]?\d|2[0-3]):([0-5]\d)/);
					if (match) {
						document.getElementById('OpeningHour').value = match[1].padStart(2, '0') + ":" + match[2];
						document.getElementById('ClosingHour').value = match[3].padStart(2, '0') + ":" + match[4];
						statusLabel.innerHTML = "<span>✅ Hours synced</span>";
						statusLabel.className = "text-success fw-bold small";
					} else { statusLabel.innerHTML = `<i class="bi bi-info-circle"></i> Check hours: ${element.tags.opening_hours}`; }
				} else { statusLabel.innerHTML = "<i class='bi bi-info-circle'></i> Hours not found."; }
			} catch (e) { statusLabel.innerText = "Check hours manually."; }
		}
	</script>
}