		async function getCitySuggestions() {
			const container = document.getElementById('suggestionListContainer');
			const cat = document.getElementById('categoryFilter').value;

			// Show spinner
			container.innerHTML = `<div class="text-center p-5"><div class="spinner-border text-success" role="status"></div></div>`;

			const token = mapboxgl.accessToken;
			try {
				const geoRes = await fetch(`https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent("@Model.City, @Model.Country")}.json?access_token=${token}`);
				const geoData = await geoRes.json();

				if (!geoData.features || geoData.features.length === 0) {
					container.innerHTML = `<div class="p-4 text-center text-muted">City coordinates not found.</div>`;
					return;
				}

				const [lng, lat] = geoData.features[0].center;

				const catsToSearch = cat === 'random'
					? ["museum", "historic site", "park", "tourist attraction"]
					: [cat.replace(/_/g, ' ')];

				let allFeatures = [];
				const seen = new Set();

				// Create a quick lookup list of names you already have in your itinerary
				const alreadyAddedNames = existingLocations.map(loc => loc.name.toLowerCase().trim());

				for (let c of catsToSearch) {
					const res = await fetch(`https://api.mapbox.com/search/searchbox/v1/forward?q=${encodeURIComponent(c)}&access_token=${token}&proximity=${lng},${lat}&limit=10&language=en`);
					const data = await res.json();

					if (data.features) {
						data.features.forEach(f => {
							const placeName = f.properties.name ? f.properties.name.toLowerCase().trim() : "";

							// ONLY add it if it's unique AND not already in 'alreadyAddedNames'
							if (placeName && !seen.has(placeName) && !alreadyAddedNames.includes(placeName)) {
								seen.add(placeName);
								allFeatures.push(f);
							}
						});
					}
				}

				if (cat === 'random') {
					allFeatures = allFeatures.sort(() => 0.5 - Math.random());
				}

				currentSuggestions = allFeatures;
				visibleSuggestionsCount = 0;

				renderSuggestions(true);

			} catch (e) {
				console.error("Suggestion Error:", e);
				container.innerHTML = `<div class="p-4 text-center text-danger">Failed to load suggestions. Check console for details.</div>`;
			}
		}

		function renderSuggestions(isInitialLoad = false) {
			const container = document.getElementById('suggestionListContainer');

			// If this is the first load, clear the spinner
			if (isInitialLoad) {
				container.innerHTML = "";
				if (currentSuggestions.length === 0) {
					container.innerHTML = `<div class="p-4 text-center text-muted">No spots found for this category.</div>`;
					return;
				}
			} else {
				// If clicking "Load More", remove the button temporarily so we can add more items below
				const loadMoreBtn = document.getElementById('loadMoreBtnContainer');
				if (loadMoreBtn) loadMoreBtn.remove();
			}

			// Grab the next 5 items from our saved array
			const nextBatch = currentSuggestions.slice(visibleSuggestionsCount, visibleSuggestionsCount + ITEMS_PER_PAGE);

			const html = nextBatch.map(feat => {
				const p = feat.properties;
				const mbCats = p.poi_category || [];
				const dbTagsHtml = allSystemTags.filter(st => mbCats.some(c => st.name.toLowerCase().includes(c.toLowerCase().replace(/_/g,' ')))).map(t => `
					<span class="badge rounded-pill px-2 py-1" style="background:${t.color}15; color:${t.color}; border:1px solid ${t.color}; font-size:10px; font-weight:700;"><i class="bi ${t.icon}"></i> ${t.name}</span>`).join('');

				const encodedFeat = encodeURIComponent(JSON.stringify(feat)).replace(/'/g, "%27");

				return `
					<div class="card location-card shadow-sm border-0 mb-2" style="cursor: pointer;" onclick="selectSuggestedLocation('${encodedFeat}')">
						<div class="card-body p-3">
							<h6 class="fw-bold m-0">${p.name}</h6>
							<small class="text-muted d-block text-truncate mb-2" style="font-size:0.75rem;">${p.full_address || p.place_formatted || ''}</small>
							<div class="d-flex flex-wrap gap-1">${dbTagsHtml}</div>
						</div>
					</div>`;
			}).join('');

			// Append the new HTML to the bottom of the list without deleting what's already there
			container.insertAdjacentHTML('beforeend', html);
			visibleSuggestionsCount += nextBatch.length;

			// If we still have more items in our array that haven't been shown yet, add the button back
			if (visibleSuggestionsCount < currentSuggestions.length) {
				container.insertAdjacentHTML('beforeend', `
					<div id="loadMoreBtnContainer" class="text-center mt-3 mb-4">
						<button class="btn btn-sm rounded-pill px-4 fw-bold shadow-sm"
								style="border: 1px solid var(--p3); color: var(--p5); background-color: var(--p1);"
								onclick="renderSuggestions()">
							<i class="bi bi-arrow-down me-1"></i> Load More
						</button>
					</div>
				`);
			}
		}

		function selectSuggestedLocation(encoded) {
