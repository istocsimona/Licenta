		async function saveLocationViaAjax() {
			const form = document.getElementById('locationForm');
			const lat = parseFloat(document.getElementById('Latitude').value);
			const lng = parseFloat(document.getElementById('Longitude').value);
			const name = document.getElementById('Name').value;

			if (!lat || !lng) {
				Swal.fire('Wait!', 'Please select a location first.', 'info');
				return;
			}

			const formData = new FormData(form);
			try {
				const response = await fetch(form.action, {
					method: 'POST',
					body: formData,
					headers: { 'X-Requested-With': 'XMLHttpRequest' }
				});

				if (response.ok) {
					Swal.fire({ title: 'Success!', text: 'Location added.', icon: 'success', timer: 1500, showConfirmButton: false });

					// --- NEW LOGIC TO ADD PIN IMMEDIATELY ---
					// Extract colors from the hidden inputs we just sent
					const selectedColors = [];
					document.querySelectorAll('#tagInputsContainer input').forEach(input => {
						const tagId = input.value;
						const tag = allSystemTags.find(t => t.tagId == tagId);
						if (tag) selectedColors.push(tag.color);
					});
					existingLocations.push({ lat: lat, lng: lng });
					// Create the custom split pin and add it to the map
					new mapboxgl.Marker({ element: createSplitPin(selectedColors) })
						.setLngLat([lng, lat])
						.setPopup(new mapboxgl.Popup({ offset: 25 }).setHTML(`<h6>${name}</h6>`)) // Optional: add a popup
						.addTo(map);
					// ----------------------------------------

					form.reset();
					form.style.display = 'none';
					document.getElementById('empty-state').style.display = 'flex';

					if (currentMarker) currentMarker.remove(); // Remove the "searching" marker

					refreshLocationList();
					bootstrap.Tab.getOrCreateInstance(document.getElementById('pills-list-tab')).show();
					await loadExistingPins();
				} else {
					Swal.fire('Error', 'Could not save.', 'error');
				}
			} catch (e) { console.error(e); }
		}

