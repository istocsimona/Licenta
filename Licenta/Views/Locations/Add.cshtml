		// Updated to catch 'e' so clicking delete doesn't open the Details view
				async function deleteLocation(e, id) {
			if (e) e.stopPropagation();

			const result = await Swal.fire({
				title: 'Are you sure?',
				text: "This will remove the location and any associated events!",
				icon: 'warning',
				showCancelButton: true,
				confirmButtonText: 'Yes, delete it!'
			});

			if (result.isConfirmed) {
				try {
					const response = await fetch(`/Locations/DeleteLocation?id=${id}`, {
						method: 'POST',
						headers: { 'X-Requested-With': 'XMLHttpRequest' }
					});

					if (response.ok) {
						// --- THE KEY ADDITION ---
						// Remove the pin from the map immediately
						if (mapMarkers[id]) {
							mapMarkers[id].remove(); // This deletes it from the Mapbox map
							delete mapMarkers[id];   // This removes it from our tracking list
						}

						Swal.fire({ title: 'Deleted!', icon: 'success', timer: 1000, showConfirmButton: false });

						refreshLocationList(); // Refresh the sidebar
					}
				} catch (e) { console.error(e); }
			}
		}

