@model Licenta.Models.Trip
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
	ViewData["Title"] = "Add Location";
}

<link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
		:root {
				--p1: #F4F7F0;
				--p2: #E9F0E6;
				--p3: #79B4A9; /* Accent Green */
				--p4: #676F54; /* Sage Text */
				--p5: #4A503D; /* Darker Text */

	}


	/* --- GLOBAL & TYPOGRAPHY --- */
		.page-title {
				color: var(--p4);
				font-weight: 800;
				letter-spacing: -0.5px;

	}


	/* --- BACK BUTTON --- */
		.back-link {
				display: inline-flex;
				align-items: center;
				text-decoration: none !important;
				color: #6c757d;
				font-weight: 500;
				transition: color 0.3s ease;
				margin-bottom: 0.5rem;

	}

				.back-link i {
						display: inline-block;
						transition: transform 0.3s ease;
						margin-right: 0.5rem;
						font-size: 1.1rem;

		}

				.back-link:hover {
						color: var(--p3) !important;

		}

				.back-link:hover i {
						transform: translateX(-6px);

	}


	/* --- CONTAINERS & TABS --- */
		.map-container, #locationForm, .empty-state-placeholder, #locationListContainer {
				height: 520px !important;
				border-radius: 1.5rem;

	}


	/* Tab Navigation Styling */
		.nav-pills .nav-link {
				color: var(--p4);
				font-weight: 700;
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				padding: 0.6rem 1.2rem;
				border-radius: 50px;
				transition: all 0.3s ease;
				border: 1px solid transparent;

	}

				.nav-pills .nav-link.active {
						background-color: var(--p3) !important;
						color: white !important;
						box-shadow: 0 4px 12px rgba(121, 180, 169, 0.3);

		}

				.nav-pills .nav-link:not(.active):hover {
						background-color: var(--p2);
						color: var(--p5);

		}


	/* --- SIDEBAR LIST CARDS --- */
		.location-card {
				background-color: #ffffff;
				border: 1px solid var(--p2);
				border-radius: 1.2rem !important;
				transition: all 0.3s ease;
				margin-bottom: 0.75rem;

	}

				.location-card:hover {
						transform: translateY(-3px);
						box-shadow: 0 8px 20px rgba(103, 111, 84, 0.1);
						border-color: var(--p3);

		}


	/* --- FORM & SEARCH --- */
		#locationForm {
				background-color: #ffffff;
				padding: 2rem;
				border: 1px solid var(--p2);
				box-shadow: 0 8px 30px rgba(103, 111, 84, 0.08);

	}

		.search-wrapper {
				background: #ffffff;
				border-radius: 50px;
				padding: 0 10px;
				box-shadow: 0 4px 15px rgba(103, 111, 84, 0.08);
				border: 1px solid rgba(121, 180, 169, 0.3);
				margin-bottom: 1rem;

	}

		.map-container {
				width: 100%;
				overflow: hidden;
				box-shadow: 0 10px 30px rgba(103, 111, 84, 0.15);
				border: 1px solid rgba(121, 180, 169, 0.2);

	}

		.empty-state-placeholder {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				background-color: var(--p1);
				color: var(--p4);
				border: 2px dashed var(--p2);

	}

		.form-label {
				font-weight: 700;
				font-size: 0.7rem;
				text-transform: uppercase;
				color: var(--p4);
				margin-bottom: 0.4rem;

	}

		.form-control {
				border-radius: 0.8rem;
				border: 1px solid #e4e8dc;
				background-color: var(--p1);

	}

			.form-control:focus {
					border-color: var(--p3);
					box-shadow: 0 0 0 0.25rem rgba(121, 180, 169, 0.1);

	}


	/* --- BUTTONS & ANIMATIONS --- */
		.btn-save {
				background-color: var(--p3) !important;
				color: white !important;
				border: none;
				border-radius: 1rem;
				padding: 1rem;
				width: 100%;
				font-weight: 700;
				transition: all 0.3s ease;

	}

				.btn-save:hover {
						background-color: var(--p4) !important;
						box-shadow: 0 6px 15px rgba(103, 111, 84, 0.2);
						transform: translateY(-2px);

		}

		.animate-pulse {
				animation: pulse 1.5s infinite;

	}

		@@keyframes pulse {
				0%, 100%

	{
					opacity: 1;

	}

			50% {
					opacity: .5;

	}


	}

		.custom-scrollbar::-webkit-scrollbar {
				width: 5px;

	}

		.custom-scrollbar::-webkit-scrollbar-track {
				background: transparent;

	}

		.custom-scrollbar::-webkit-scrollbar-thumb {
				background: var(--p2);
				border-radius: 10px;

	}


	/* --- DURATION CARD (REVERTED STYLE) --- */
			.duration-card {
				background: var(--p1);
				border-radius: 1.2rem;
				padding: 1.25rem;
				border: 1px solid rgba(121, 180, 169, 0.2);
				position: relative;
				transition: all 0.3s ease;
			}


	.form-control-time {
		background-color: #ffffff;
		border: 1px solid #e4e8dc;
		border-radius: 8px;
		padding: 0.4rem 0.8rem;
		font-size: 0.9rem;
		text-align: center;
		width: 100%;
	}

	.time-input-wrapper i {
		display: none;
	}

	.duration-input {
		font-size: 1.4rem;
		width: 55px;
		background: transparent;
		border: none;
		color: var(--p5);
		font-weight: 800;
	}

	.border-end {
		border-right: 2px solid rgba(121, 180, 169, 0.1) !important;
	}

	/* Position the edit/toggle container in the corner */
	.duration-card {
		position: relative; /* Required for absolute positioning of children */
	}

	.edit-toggle-container {
		position: absolute;
		top: 8px;
		right: 8px;
		z-index: 10;
	}

	.btn-edit-mode {
		background: white;
		border: 1px solid var(--p2);
		border-radius: 8px;
		padding: 2px 8px;
		font-size: 0.8rem;
		color: var(--p4);
		transition: all 0.2s ease;
		box-shadow: 0 2px 5px rgba(0,0,0,0.05);
	}

		.btn-edit-mode:hover {
			background: var(--p1);
			color: var(--p3);
		}

	/* Visual feedback when in edit mode */
	.duration-card.editing-active {
		border: 1px solid var(--p3);
		background-color: #fff;
		box-shadow: 0 0 0 3px rgba(121, 180, 169, 0.1);
	}
	/* Removes the spin buttons on the number input for a cleaner look */
			.duration-input::-webkit-outer-spin-button,
			.duration-input::-webkit-inner-spin-button {
					-webkit-appearance: none;
					margin: 0;

	}

		.duration-unit {
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				color: var(--p3);

	}


	/* --- POLISHED TIME INPUTS --- */
		.form-control-time {
				display: flex;
				align-items: center;
				background-color: var(--p1);
				border: 1px solid #e4e8dc;
				border-radius: 50px; /* Matching your search bar */
				padding: 0.6rem 1.2rem;
				font-weight: 600;
				color: var(--p5);
				transition: all 0.3s ease;
				cursor: pointer;
				position: relative;

	}


	/* Customizing the native time icon or clearing it for some browsers */
		input[type="time"]::-webkit-calendar-picker-indicator {
				background: transparent;
				bottom: 0;
				color: transparent;
				cursor: pointer;
				height: auto;
				left: 0;
				position: absolute;
				right: 0;
				top: 0;
				width: auto;

	}


	/* The visible clock icon we want */
		.time-input-wrapper {
				position: relative;
				display: block;

	}

				.time-input-wrapper i {
						position: absolute;
						right: 15px;
						top: 50%;
						transform: translateY(-50%);
						color: var(--p5);
						pointer-events: none;
						font-size: 1.1rem;

		}

		.form-control-time:focus-within {
				border-color: var(--p3);
				box-shadow: 0 0 0 0.25rem rgba(121, 180, 169, 0.1);

	}


	/* --- CUSTOM FLATPICKR (SAGE THEME) --- */
		.flatpickr-calendar {
				background: #fff;
				border-radius: 15px;
				box-shadow: 0 10px 25px rgba(103, 111, 84, 0.15);
				border: 1px solid var(--p2);

	}


	/* Change the blue highlight to your Accent Green (--p3) */
		.flatpickr-time input:hover,
		.flatpickr-time .flatpickr-am-pm:hover,
		.flatpickr-time input:focus,
		.flatpickr-time .flatpickr-am-pm:focus {
				background: var(--p2) !important;

	}

		.flatpickr-time .flatpickr-time-separator {
				color: var(--p4);
				font-weight: bold;

	}


	/* Style the arrow buttons */
		.flatpickr-time .numInputWrapper span.arrowUp:after {
				border-bottom-color: var(--p3);

	}

		.flatpickr-time .numInputWrapper span.arrowDown:after {
				border-top-color: var(--p3);

	}


	/* Remove the default native browser picker icon entirely */
		input[type="time"]::-webkit-calendar-picker-indicator {
				display: none;

	}
</style>

<div class="mb-4 mt-2">
	<a asp-controller="Trips" asp-action="Index" class="back-link mb-2 d-inline-block">
		<i class="bi bi-arrow-left"></i> Back to Trips
	</a>
	<h1 class="page-title mb-1">Add locations in @Model.City</h1>
	<p class="text-muted">Search for a place to add it to your itinerary.</p>
</div>

<div class="row g-4 mb-5">
	<div class="col-lg-7">
		<div class="search-wrapper">
			<mapbox-search-box id="searchBox"
							   access-token="@Configuration["Mapbox:PublicKey"]"
							   placeholder="Find a place in @Model.City..."
							   language="en,it,ro,de,fr,es"
							   style="width:100%;">
			</mapbox-search-box>
		</div>

		<div class="map-container">
			<div id="map" style="width: 100%; height: 100%;"></div>
		</div>

		<div class="search-hint mt-2">
			<i class="bi bi-info-circle me-1"></i> Suggestions biased to <strong>@Model.City</strong>
		</div>
	</div>

	<div class="col-lg-5">
		<ul class="nav nav-pills mb-3 justify-content-center" id="pills-tab" role="tablist">
			<li class="nav-item" role="presentation">
				<button class="nav-link active" id="pills-add-tab" data-bs-toggle="pill" data-bs-target="#pills-add" type="button" role="tab" aria-controls="pills-add" aria-selected="true">
					<i class="bi bi-plus-circle me-1"></i> Add New
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="pills-suggest-tab" data-bs-toggle="pill" data-bs-target="#pills-suggest" type="button" role="tab" onclick="getCitySuggestions()">
					<i class="bi bi-magic me-1"></i> Suggestions
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="pills-list-tab" data-bs-toggle="pill" data-bs-target="#pills-list" type="button" role="tab" aria-controls="pills-list" aria-selected="false" onclick="refreshLocationList()">
					<i class="bi bi-list-ul me-1"></i> My Locations
				</button>
			</li>
		</ul>

		<div class="tab-content" id="pills-tabContent">

			<div class="tab-pane fade show active" id="pills-add" role="tabpanel" aria-labelledby="pills-add-tab">
				<div id="empty-state" class="empty-state-placeholder">
					<i class="bi bi-geo-alt-fill mb-3" style="font-size: 2.5rem; opacity: 0.3;"></i>
					<p>Search or select a location to see details.</p>
				</div>

				<form asp-action="SaveLocation" method="post" id="locationForm" style="display: none;">
					<div class="d-flex align-items-start mb-4">
						<div class="rounded-circle p-2 me-3 flex-shrink-0" style="background-color: rgba(121, 180, 169, 0.15); width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;">
							<i class="bi bi-geo-alt-fill" style="color: var(--p3); font-size: 1.2rem;"></i>
						</div>
						<div class="flex-grow-1">
							<h4 class="m-0 page-title" id="selectedPlaceNameText" style="font-size: 1.2rem; line-height: 1.2;">Selected Place</h4>
							<div id="tagBadges" class="mt-2 d-flex flex-wrap gap-1"></div>
						</div>
					</div>

					<div id="tagInputsContainer"></div>
					<div id="existingEventBanner" class="mb-4 p-3 shadow-sm" style="display: none; background-color: var(--p1); border: 1px solid var(--p3); border-radius: 1rem; position: relative;">
					</div>

					<input type="hidden" id="IsIndoor" name="IsIndoor" value="false" />
					<input type="hidden" name="TripId" value="@Model.TripId" />
					<input type="hidden" id="Name" name="Name" />
					<input type="hidden" id="Address" name="Address" />
					<input type="hidden" id="Latitude" name="Latitude" />
					<input type="hidden" id="Longitude" name="Longitude" />

					<div class="row g-3">
						<div class="col-12">
							<div class="duration-card" id="detailsCard">
								<div class="edit-toggle-container" id="editToggleContainer">
									<button type="button" class="btn-edit-mode" onclick="enterEditMode()" id="btnEnterEdit">
										<i class="bi bi-pencil-square me-1"></i> Edit
									</button>
									<div id="editActionButtons" style="display: none;">
										<button type="button" class="btn-edit-mode text-success border-success" onclick="exitEditMode(true)">
											<i class="bi bi-check-lg"></i>
										</button>
										<button type="button" class="btn-edit-mode text-danger border-danger" onclick="exitEditMode(false)">
											<i class="bi bi-x-lg"></i>
										</button>
									</div>
								</div>

								<div class="row align-items-center pt-2">
									<div class="col-4 border-end">
										<span class="form-label d-block mb-1">Duration</span>
										<div class="d-flex align-items-baseline">
											<input type="number" name="AvgDuration" class="duration-input" value="60" readonly>
											<span class="duration-unit">min</span>
										</div>
									</div>

									<div class="col-8 ps-4">
										<span class="form-label d-block mb-2">Operational Hours</span>
										<div class="d-flex align-items-center gap-3">
											<div class="time-input-wrapper flex-grow-1">
												<input type="text" id="OpeningHour" name="OpeningHour" class="form-control form-control-time py-1" placeholder="09:00" />
											</div>
											<span class="text-muted small fw-bold">to</span>
											<div class="time-input-wrapper flex-grow-1">
												<input type="text" id="ClosingHour" name="ClosingHour" class="form-control form-control-time py-1" placeholder="18:00" />
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="col-12 text-center mt-3">
							<small id="osmStatus" class="text-muted mb-3 d-block" style="min-height: 20px;"></small>
							<button type="button" onclick="saveLocationViaAjax()" class="btn btn-save shadow-sm py-3">
								<i class="bi bi-plus-lg me-2"></i> Add to Itinerary
							</button>
						</div>
					</div>
				</form>
			</div>

			<div class="tab-pane fade" id="pills-list" role="tabpanel" aria-labelledby="pills-list-tab">
				<div id="locationListContainer" class="custom-scrollbar p-2" style="height: 520px; overflow-y: auto;">
				</div>
			</div>
			<div class="tab-pane fade" id="pills-suggest" role="tabpanel">
				<!-- Category Filter Bar -->
				<div class="d-flex align-items-center gap-2 mb-3">
					<div class="flex-grow-1 position-relative">
						<select id="categoryFilter" class="form-select form-select-sm"
								                style="border-radius: 50px; border: 1px solid rgba(121,180,169,0.4); background: #fff;
                           color: var(--p5); font-weight: 600; font-size: 0.8rem; padding: 0.5rem 1rem;
                           appearance: none; cursor: pointer;"
								                onchange="getCitySuggestions()">
							<option value="random">✨ Random Mix</option>
							<optgroup label="Culture">
								<option value="museum">🏛 Museum</option>
								<option value="historic_site">🏰 Historic Site</option>
								<option value="art_gallery">🎨 Art Gallery</option>
							</optgroup>
							<optgroup label="Nature">
								<option value="park">🌳 Park</option>
								<option value="nature_reserve">🌿 Nature Reserve</option>
							</optgroup>
							<optgroup label="Food & Drink">
								<option value="restaurant">🍽 Restaurant</option>
								<option value="cafe">☕ Cafe</option>
								<option value="bar">🍸 Bar</option>
							</optgroup>
							<optgroup label="Landmarks">
								<option value="monument">🗿 Monument</option>
								<option value="tourist_attraction">⭐ Tourist Attraction</option>
							</optgroup>
							<optgroup label="Entertainment">
								<option value="zoo">🦁 Zoo</option>
								<option value="aquarium">🐠 Aquarium</option>
								<option value="theme_park">🎡 Theme Park</option>
								<option value="theater">🎭 Theater</option>
							</optgroup>
							<optgroup label="Shopping">
								<option value="shopping_mall">🛍 Shopping Mall</option>
							</optgroup>
						</select>
						<i class="bi bi-chevron-down position-absolute" style="right:14px;top:50%;transform:translateY(-50%);pointer-events:none;color:var(--p3);font-size:0.75rem;"></i>
					</div>
				</div>

				<div id="suggestionListContainer" class="custom-scrollbar p-1" style="height: 450px; overflow-y: auto;">
					<div class="text-center p-5">
						<div class="spinner-border text-success" role="status"></div>
						<p class="mt-2 small text-muted">Finding top spots in @Model.City...</p>
					</div>
				</div>
			</div>

		</div>
	</div>
</div>

<!-- ADD EVENT MODAL -->
<div class="modal fade" id="addEventModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content" style="border-radius: 1.2rem; background-color: #fcfdfa;">
			<div class="modal-header border-0 pt-4 px-4">
				<h5 class="modal-title page-title">Add Event Here</h5>
				<button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
			</div>
			<form asp-controller="Reservations" asp-action="Create" method="post" id="addEventForm">
				<div class="modal-body px-4">
					<input type="hidden" name="TripId" value="@Model.TripId" />

					<input type="hidden" name="location" id="EventLocationString" />
					<input type="hidden" name="latitude" id="EventLat" />
					<input type="hidden" name="longitude" id="EventLng" />

					<div class="mb-3">
						<label class="form-label fw-600">Event Name</label>
						<input type="text" name="Name" class="form-control" placeholder="Lunch, Museum Tour, Check-in..." required />
					</div>

					<div class="mb-3">
						<label class="form-label fw-600">Location</label>
						<input type="text" id="EventLocationDisplay" class="form-control" readonly style="background-color: var(--p2); color: var(--p5);" />
					</div>

					<div class="row">
						<div class="col-12 mb-3">
							<label class="form-label fw-600">Event Date</label>
							<input type="date" id="EventDateUI" class="form-control" required />
						</div>
						<div class="col-6 mb-3">
							<label class="form-label fw-600">Start Time</label>
							<input type="time" id="StartTimeUI" class="form-control" required />
						</div>
						<div class="col-6 mb-3">
							<label class="form-label fw-600">Duration (Hours)</label>
							<input type="number" id="DurationUI" class="form-control" value="1" min="0.5" step="0.5" required />
						</div>
					</div>

					<div class="mb-3 p-2 rounded text-center" style="background-color: var(--p2); color: var(--p5); border: 1px dashed var(--p3);">
						<i class="bi bi-clock-history me-1"></i> Event ends at: <strong id="EndTimeDisplay">--:--</strong>
					</div>

					<input type="hidden" name="StartDate" id="RealStartDate" />
					<input type="hidden" name="EndDate" id="RealEndDate" />
				</div>
				<div class="modal-footer border-0 pb-4 px-4">
					<button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn-save" style="width: auto; padding: 0.6rem 1.2rem;">Save Event</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
	<script defer src="https://api.mapbox.com/search-js/v1.0.0-beta.20/web.js"></script>	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
	<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

	<script>
		const allSystemTags = @Html.Raw(Json.Serialize(ViewBag.AvailableTags));
		let map;
		let currentMarker = null;
		let currentSelectedLocationId = null
		let existingLocations = []; // Store {lat, lng}

		let mapMarkers = {}; 

		let currentSuggestions = [];
		let visibleSuggestionsCount = 0;
		const ITEMS_PER_PAGE = 5;

		const CATEGORY_DURATIONS = {
			'museum': 120,
			'art_gallery': 90,
			'historic_site': 90,
			'castle': 120,
			'park': 60,
			'restaurant': 90,
			'cafe': 45,
			'bar': 60,
			'zoo': 180,
			'aquarium': 120,
			'theme_park': 240,
			'monument': 30,
			'tourist_attraction': 60,
			'shopping_mall': 120,
			'theater': 150,
