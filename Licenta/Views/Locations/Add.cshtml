		document.addEventListener('DOMContentLoaded', function () {
			mapboxgl.accessToken = '@Configuration["Mapbox:PublicKey"]';

			map = new mapboxgl.Map({
				container: 'map',
				style: 'mapbox://styles/mapbox/streets-v12',
				center: [0, 0],
				zoom: 2
			});

			map.addControl(new mapboxgl.NavigationControl(), 'top-right');

			map.on('load', () => {
				loadExistingPins();
				refreshLocationList();
			});

			// ==========================================
			// NEW CODE: MAKE MAP POIs CLICKABLE
			// ==========================================

			// Change the cursor to a pointer when hovering over a POI to show it's clickable
			map.on('mouseenter', 'poi-label', () => {
				map.getCanvas().style.cursor = 'pointer';
			});

			// Revert the cursor when leaving the POI
			map.on('mouseleave', 'poi-label', () => {
				map.getCanvas().style.cursor = '';
			});

			// Handle the actual click on the map
			map.on('click', (e) => {
				// Search the area the user clicked specifically for the 'poi-label' layer
				const features = map.queryRenderedFeatures(e.point, {
					layers: ['poi-label']
				});

				// If they didn't click on a POI, do nothing
				if (!features.length) return;

				const clickedFeature = features[0];

				// Try to get the exact POI coordinates, falling back to where the mouse clicked
				let lng = e.lngLat.lng;
				let lat = e.lngLat.lat;
				if (clickedFeature.geometry && clickedFeature.geometry.type === 'Point') {
					lng = clickedFeature.geometry.coordinates[0];
					lat = clickedFeature.geometry.coordinates[1];
				}

				// Build a mock "feature" object that matches the structure your handleLocationSelection expects
				const mockFeature = {
					geometry: {
						coordinates: [lng, lat]
					},
					properties: {
						// Grab the localized name, or fallback to the standard name
						name: clickedFeature.properties.name || clickedFeature.properties.name_en || "Selected Place",

						// Mapbox base map features usually don't carry full addresses, so we leave it blank
						full_address: "",

						// Attempt to extract a category to help your system generate the right tag badges
						poi_category: [clickedFeature.properties.category_en || clickedFeature.properties.maki || clickedFeature.properties.type || ""]
					}
				};

				// Visually switch the user back to the 'Add New' tab if they were on Suggestions/List
				const addTabTrigger = document.getElementById('pills-add-tab');
				bootstrap.Tab.getOrCreateInstance(addTabTrigger).show();

				// Update the search box text to reflect what they clicked
				const searchBox = document.getElementById('searchBox');
				if(searchBox) searchBox.value = mockFeature.properties.name;

				// Pass the data to your existing function!
				handleLocationSelection(mockFeature);
			});

			const fpConfig = { enableTime: true, noCalendar: true, dateFormat: "H:i", time_24hr: true, minuteIncrement: 5, disableMobile: "true" };
			flatpickr("#OpeningHour", fpConfig);
			flatpickr("#ClosingHour", fpConfig);

			const cityQuery = "@Model.City, @Model.Country";
			const searchBox = document.getElementById('searchBox');

			fetch(`https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(cityQuery)}.json?access_token=${mapboxgl.accessToken}`)
				.then(res => res.json())
				.then(data => {
					if (data.features && data.features.length > 0) {
						const feature = data.features[0];
						const coords = feature.center; // This is an array: [lng, lat]

						// Center the map on the city
						map.flyTo({ center: coords, zoom: 12 });

						// FIX: Properly apply proximity and bounding box bias to the search box
						const searchOptions = {
							proximity: coords
						};

						if (feature.bbox) {
							searchOptions.bbox = feature.bbox; // Expects array: [minX, minY, maxX, maxY]
						}

						// Apply the options to the Mapbox component
						searchBox.options = searchOptions;
					}
				});

			searchBox.addEventListener('retrieve', (e) => {
				handleLocationSelection(e.detail.features[0]);
			});

			const categoryDropdown = document.getElementById('categoryFilter');
			if (categoryDropdown) {
				categoryDropdown.addEventListener('change', function() {
					getCitySuggestions();
				});
			}
		});

