@model Licenta.Models.Trip
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Add Location";
}

<link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --p1: #F4F7F0;
        --p2: #E9F0E6;
        --p3: #79B4A9; /* Accent Green */
        --p4: #676F54; /* Sage Text */
        --p5: #4A503D; /* Darker Text */
    }

    /* --- GLOBAL & TYPOGRAPHY --- */
    .page-title {
        color: var(--p4);
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    /* --- BACK BUTTON --- */
    .back-link {
        display: inline-flex;
        align-items: center;
        text-decoration: none !important;
        color: #6c757d;
        font-weight: 500;
        transition: color 0.3s ease;
        margin-bottom: 0.5rem;
    }

        .back-link i {
            display: inline-block;
            transition: transform 0.3s ease;
            margin-right: 0.5rem;
            font-size: 1.1rem;
        }

        .back-link:hover {
            color: var(--p3) !important;
        }

            .back-link:hover i {
                transform: translateX(-6px);
            }

    /* --- CONTAINERS & TABS --- */
    .map-container, #locationForm, .empty-state-placeholder, #locationListContainer {
        height: 520px !important;
        border-radius: 1.5rem;
    }

    /* Tab Navigation Styling */
    .nav-pills .nav-link {
        color: var(--p4);
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 0.6rem 1.2rem;
        border-radius: 50px;
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }

        .nav-pills .nav-link.active {
            background-color: var(--p3) !important;
            color: white !important;
            box-shadow: 0 4px 12px rgba(121, 180, 169, 0.3);
        }

        .nav-pills .nav-link:not(.active):hover {
            background-color: var(--p2);
            color: var(--p5);
        }

    /* --- SIDEBAR LIST CARDS --- */
    .location-card {
        background-color: #ffffff;
        border: 1px solid var(--p2);
        border-radius: 1.2rem !important;
        transition: all 0.3s ease;
        margin-bottom: 0.75rem;
    }

        .location-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(103, 111, 84, 0.1);
            border-color: var(--p3);
        }

    /* --- FORM & SEARCH --- */
    #locationForm {
        background-color: #ffffff;
        padding: 2rem;
        border: 1px solid var(--p2);
        box-shadow: 0 8px 30px rgba(103, 111, 84, 0.08);
    }

    .search-wrapper {
        background: #ffffff;
        border-radius: 50px;
        padding: 0 10px;
        box-shadow: 0 4px 15px rgba(103, 111, 84, 0.08);
        border: 1px solid rgba(121, 180, 169, 0.3);
        margin-bottom: 1rem;
    }

    .map-container {
        width: 100%;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(103, 111, 84, 0.15);
        border: 1px solid rgba(121, 180, 169, 0.2);
    }

    .empty-state-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: var(--p1);
        color: var(--p4);
        border: 2px dashed var(--p2);
    }

    .form-label {
        font-weight: 700;
        font-size: 0.7rem;
        text-transform: uppercase;
        color: var(--p4);
        margin-bottom: 0.4rem;
    }

    .form-control {
        border-radius: 0.8rem;
        border: 1px solid #e4e8dc;
        background-color: var(--p1);
    }

        .form-control:focus {
            border-color: var(--p3);
            box-shadow: 0 0 0 0.25rem rgba(121, 180, 169, 0.1);
        }

    /* --- BUTTONS & ANIMATIONS --- */
    .btn-save {
        background-color: var(--p3) !important;
        color: white !important;
        border: none;
        border-radius: 1rem;
        padding: 1rem;
        width: 100%;
        font-weight: 700;
        transition: all 0.3s ease;
    }

        .btn-save:hover {
            background-color: var(--p4) !important;
            box-shadow: 0 6px 15px rgba(103, 111, 84, 0.2);
            transform: translateY(-2px);
        }

    .animate-pulse {
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: .5;
    }

    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--p2);
        border-radius: 10px;
    }
    /* --- DURATION CARD (REVERTED STYLE) --- */
    .duration-card {
        background: var(--p1);
        border-radius: 1rem;
        padding: 1rem;
        border: 1px solid rgba(121, 180, 169, 0.2);
    }

    .duration-input {
        font-size: 1.2rem;
        font-weight: 700;
        width: 65px; /* Slightly wider for 3 digits */
        background: transparent;
        border: none;
        outline: none;
        color: var(--p5);
        text-align: center;
    }

        /* Removes the spin buttons on the number input for a cleaner look */
        .duration-input::-webkit-outer-spin-button,
        .duration-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

    .duration-unit {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--p3);
    }

    /* --- POLISHED TIME INPUTS --- */
    .form-control-time {
        display: flex;
        align-items: center;
        background-color: var(--p1);
        border: 1px solid #e4e8dc;
        border-radius: 50px; /* Matching your search bar */
        padding: 0.6rem 1.2rem;
        font-weight: 600;
        color: var(--p5);
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
    }

    /* Customizing the native time icon or clearing it for some browsers */
    input[type="time"]::-webkit-calendar-picker-indicator {
        background: transparent;
        bottom: 0;
        color: transparent;
        cursor: pointer;
        height: auto;
        left: 0;
        position: absolute;
        right: 0;
        top: 0;
        width: auto;
    }

    /* The visible clock icon we want */
    .time-input-wrapper {
        position: relative;
        display: block;
    }

        .time-input-wrapper i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--p5);
            pointer-events: none;
            font-size: 1.1rem;
        }

    .form-control-time:focus-within {
        border-color: var(--p3);
        box-shadow: 0 0 0 0.25rem rgba(121, 180, 169, 0.1);
    }

    /* --- CUSTOM FLATPICKR (SAGE THEME) --- */
    .flatpickr-calendar {
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(103, 111, 84, 0.15);
        border: 1px solid var(--p2);
    }

    /* Change the blue highlight to your Accent Green (--p3) */
    .flatpickr-time input:hover,
    .flatpickr-time .flatpickr-am-pm:hover,
    .flatpickr-time input:focus,
    .flatpickr-time .flatpickr-am-pm:focus {
        background: var(--p2) !important;
    }

    .flatpickr-time .flatpickr-time-separator {
        color: var(--p4);
        font-weight: bold;
    }

    /* Style the arrow buttons */
    .flatpickr-time .numInputWrapper span.arrowUp:after {
        border-bottom-color: var(--p3);
    }

    .flatpickr-time .numInputWrapper span.arrowDown:after {
        border-top-color: var(--p3);
    }

    /* Remove the default native browser picker icon entirely */
    input[type="time"]::-webkit-calendar-picker-indicator {
        display: none;
    }
</style>

<div class="mb-4 mt-2">
    <a asp-controller="Trips" asp-action="Index" class="back-link mb-2 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Trips
    </a>
    <h1 class="page-title mb-1">Add locations in @Model.City</h1>
    <p class="text-muted">Search for a place to add it to your itinerary.</p>
</div>

<div class="row g-4 mb-5">
    <div class="col-lg-7">
        <div class="search-wrapper">
            <mapbox-search-box id="searchBox"
                               access-token="@Configuration["Mapbox:PublicKey"]"
                               placeholder="Find a place in @Model.City..."
                               style="width:100%;">
            </mapbox-search-box>
        </div>

        <div class="map-container">
            <div id="map" style="width: 100%; height: 100%;"></div>
        </div>

        <div class="search-hint mt-2">
            <i class="bi bi-info-circle me-1"></i> Suggestions biased to <strong>@Model.City</strong>
        </div>
    </div>

    <div class="col-lg-5">
        <ul class="nav nav-pills mb-3 justify-content-center" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="pills-add-tab" data-bs-toggle="pill" data-bs-target="#pills-add" type="button" role="tab" aria-controls="pills-add" aria-selected="true">
                    <i class="bi bi-plus-circle me-1"></i> Add New
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-list-tab" data-bs-toggle="pill" data-bs-target="#pills-list" type="button" role="tab" aria-controls="pills-list" aria-selected="false" onclick="refreshLocationList()">
                    <i class="bi bi-list-ul me-1"></i> My Locations
                </button>
            </li>
        </ul>

        <div class="tab-content" id="pills-tabContent">

            <div class="tab-pane fade show active" id="pills-add" role="tabpanel" aria-labelledby="pills-add-tab">
                <div id="empty-state" class="empty-state-placeholder">
                    <i class="bi bi-geo-alt-fill mb-3" style="font-size: 2.5rem; opacity: 0.3;"></i>
                    <p>Search or select a location to see details.</p>
                </div>

                <form asp-action="SaveLocation" method="post" id="locationForm" style="display: none;">
                    <div class="d-flex align-items-start mb-4">
                        <div class="rounded-circle p-2 me-3 flex-shrink-0" style="background-color: rgba(121, 180, 169, 0.15); width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-geo-alt-fill" style="color: var(--p3); font-size: 1.2rem;"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h4 class="m-0 page-title" id="selectedPlaceNameText" style="font-size: 1.2rem; line-height: 1.2;">Selected Place</h4>
                            <div id="tagBadges" class="mt-2 d-flex flex-wrap gap-1"></div>
                        </div>
                    </div>

                    <div id="tagInputsContainer"></div>

                    <input type="hidden" id="IsIndoor" name="IsIndoor" value="false" />
                    <input type="hidden" name="TripId" value="@Model.TripId" />
                    <input type="hidden" id="Name" name="Name" />
                    <input type="hidden" id="Latitude" name="Latitude" />
                    <input type="hidden" id="Longitude" name="Longitude" />

                    <div class="row g-3">
                                <div class="col-12">
                                    <div class="duration-card d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="form-label d-block">Avg. Duration</span>
                                            <div class="d-flex align-items-baseline">
                                                <input type="number" name="AvgDuration" class="duration-input" value="60" />
                                                <span class="duration-unit">mins</span>
                                            </div>
                                        </div>
                                        <i class="bi bi-clock-history" style="font-size: 1.5rem; color: var(--p3); opacity: 0.5;"></i>
                                    </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label">Opening Hour</label>
                            <div class="time-input-wrapper">
                                <input type="text" id="OpeningHour" name="OpeningHour" class="form-control form-control-time" placeholder="09:00" />
                                <i class="bi bi-clock"></i>
                            </div>
                        </div>

                        <div class="col-6">
                            <label class="form-label">Closing Hour</label>
                            <div class="time-input-wrapper">
                                <input type="text" id="ClosingHour" name="ClosingHour" class="form-control form-control-time" placeholder="18:00" />
                                <i class="bi bi-clock"></i>
                            </div>
                        </div>

                        <div class="col-12 text-center mt-4">
                            <small id="osmStatus" class="text-muted mb-3 d-block" style="min-height: 20px;"></small>
                            <button type="button" onclick="saveLocationViaAjax()" class="btn btn-save shadow-sm py-3">
                                <i class="bi bi-plus-lg me-2"></i> Add to Itinerary
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="tab-pane fade" id="pills-list" role="tabpanel" aria-labelledby="pills-list-tab">
                <div id="locationListContainer" class="custom-scrollbar p-2" style="height: 520px; overflow-y: auto;">
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
    <script src="https://api.mapbox.com/search-js/v1.0.0-beta.20/web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        const allSystemTags = @Html.Raw(Json.Serialize(ViewBag.AvailableTags));
        let map;
        let currentMarker = null;

        document.addEventListener('DOMContentLoaded', function () {
            mapboxgl.accessToken = '@Configuration["Mapbox:PublicKey"]';

            // 1. Initialize Map
            map = new mapboxgl.Map({
                container: 'map',
                style: 'mapbox://styles/mapbox/streets-v12',
                center: [0, 0],
                zoom: 2
            });

            map.addControl(new mapboxgl.NavigationControl(), 'top-right');

            map.on('load', () => {
                loadExistingPins();
                refreshLocationList();
            });

            // 2. Initialize Aesthetic Clock (Flatpickr)
            const fpConfig = {
                enableTime: true,
                noCalendar: true,
                dateFormat: "H:i",
                time_24hr: true,
                minuteIncrement: 5,
                disableMobile: "true"
            };
            flatpickr("#OpeningHour", fpConfig);
            flatpickr("#ClosingHour", fpConfig);

            // 3. Initial Map Focus on Trip City
            const cityQuery = "@Model.City, @Model.Country";
            const searchBox = document.getElementById('searchBox');

            fetch(`https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(cityQuery)}.json?access_token=${mapboxgl.accessToken}`)
                .then(res => res.json())
                .then(data => {
                    if (data.features && data.features.length > 0) {
                        const coords = data.features[0].center;
                        map.flyTo({ center: coords, zoom: 13 });
                        searchBox.proximity = coords.join(',');
                    }
                });

            // 4. Search Result Logic
            searchBox.addEventListener('retrieve', (e) => {
                const feature = e.detail.features[0];
                if (!feature) return;

                const coords = feature.geometry.coordinates;
                const props = feature.properties;
                const mbCategories = props.poi_category || (props.maki ? [props.maki] : []);
                const categoryStr = mbCategories.join(' ').toLowerCase();

                document.getElementById('Name').value = props.name || props.full_address;
                document.getElementById('selectedPlaceNameText').innerText = props.name || "Selected Place";
                document.getElementById('Longitude').value = coords[0];
                document.getElementById('Latitude').value = coords[1];

                const indoorKeywords = ["museum", "art", "restaurant", "cafe", "church", "cathedral", "gallery", "mall", "cinema", "theater"];
                const isIndoor = indoorKeywords.some(keyword => categoryStr.includes(keyword));
                document.getElementById('IsIndoor').value = isIndoor;

                let duration = 60;
                if (categoryStr.includes("museum") || categoryStr.includes("art")) duration = 180;
                else if (categoryStr.includes("park") || categoryStr.includes("garden")) duration = 45;
                else if (categoryStr.includes("restaurant") || categoryStr.includes("cafe")) duration = 90;
                else if (categoryStr.includes("monument") || categoryStr.includes("fountain")) duration = 20;
                document.querySelector('input[name="AvgDuration"]').value = duration;

                const tagBadgesContainer = document.getElementById('tagBadges');
                const tagInputsContainer = document.getElementById('tagInputsContainer');
                tagBadgesContainer.innerHTML = "";
                tagInputsContainer.innerHTML = "";

                const indoorBadge = document.createElement('span');
                indoorBadge.className = "badge rounded-pill px-2 py-1 me-1";
                indoorBadge.style.backgroundColor = isIndoor ? "#E9F0E6" : "#FFF4E6";
                indoorBadge.style.color = isIndoor ? "#4A503D" : "#A0522D";
                indoorBadge.style.border = isIndoor ? "1px solid #79B4A9" : "1px solid #FFD8A8";
                indoorBadge.innerHTML = isIndoor ? '<i class="bi bi-house-door-fill"></i> Indoor' : '<i class="bi bi-tree-fill"></i> Outdoor';
                tagBadgesContainer.appendChild(indoorBadge);

                const matchedTags = allSystemTags.filter(sysTag => {
                    return mbCategories.some(cat =>
                        cat.toLowerCase().includes(sysTag.name.toLowerCase()) ||
                        sysTag.name.toLowerCase().includes(cat.toLowerCase())
                    );
                });

                matchedTags.forEach(tag => {
                    const span = document.createElement('span');
                    span.className = "badge rounded-pill px-2 py-1";
                    span.style.backgroundColor = tag.color + "22";
                    span.style.color = tag.color;
                    span.style.border = `1px solid ${tag.color}`;
                    span.style.fontSize = "0.65rem";
                    span.innerHTML = `<i class="bi bi-tag-fill me-1"></i> ${tag.name}`;
                    tagBadgesContainer.appendChild(span);

                    const input = document.createElement('input');
                    input.type = "hidden";
                    input.name = "SelectedTagIds";
                    input.value = tag.tagId;
                    tagInputsContainer.appendChild(input);
                });

                document.getElementById('empty-state').style.display = 'none';
                document.getElementById('locationForm').style.display = 'block';

                if (currentMarker) currentMarker.remove();
                currentMarker = new mapboxgl.Marker({ color: '#79B4A9' }).setLngLat(coords).addTo(map);
                map.flyTo({ center: coords, zoom: 15 });

                tryFetchHours();
            });
        });

        async function saveLocationViaAjax() {
            const form = document.getElementById('locationForm');
            const statusLabel = document.getElementById('osmStatus');
            const lat = document.getElementById('Latitude').value;
            const lng = document.getElementById('Longitude').value;
            const name = document.getElementById('Name').value;

            if (!lat || !lng) {
                alert("Please select a location on the map first.");
                return;
            }

            const formData = new FormData(form);
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                let result;
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.includes("application/json")) {
                    result = await response.json();
                }

                if (response.ok) {
                    const tagHtml = document.getElementById('tagBadges').innerHTML;
                    const tagColors = Array.from(document.querySelectorAll('#tagBadges span'))
                                           .map(s => s.style.color).filter(c => c);

                    new mapboxgl.Marker({ element: createSplitPin(tagColors) })
                        .setLngLat([parseFloat(lng), parseFloat(lat)])
                        .setPopup(new mapboxgl.Popup({ offset: 25 })
                            .setHTML(`<div class="p-1"><strong>${name}</strong><div class="mt-1 d-flex flex-wrap gap-1">${tagHtml}</div></div>`))
                        .addTo(map);

                    form.reset();
                    form.style.display = 'none';
                    document.getElementById('empty-state').style.display = 'flex';
                    if (currentMarker) currentMarker.remove();

                    const listTab = new bootstrap.Tab(document.getElementById('pills-list-tab'));
                    listTab.show();
                    refreshLocationList();

                    statusLabel.innerText = "✅ Saved to itinerary!";
                    statusLabel.className = "text-success fw-bold small";
                } else {
                    alert("Save failed: " + (result?.message || "Check required fields."));
                }
            } catch (e) { console.error("Save Error:", e); }
        }

                async function refreshLocationList() {
            const container = document.getElementById('locationListContainer');
            const tripId = "@Model.TripId";

            try {
                const response = await fetch(`/Locations/GetTripLocations?tripId=${tripId}`);
                const locations = await response.json();

                if (locations.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state-placeholder" style="height: 100% !important; border: none;">
                            <i class="bi bi-journal-x mb-2" style="font-size: 2rem; opacity: 0.3;"></i>
                            <p class="small text-muted">No locations added yet.</p>
                        </div>`;
                    return;
                }

                container.innerHTML = locations.map(loc => `
                    <div class="card location-card shadow-sm border-0" id="loc-card-${loc.locationId}">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold m-0" style="color: var(--p5); font-size: 1rem;">${loc.name}</h6>
                                <button onclick="deleteLocation(${loc.locationId})" class="btn btn-sm btn-outline-danger border-0 rounded-circle">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                            <div class="d-flex align-items-center small text-muted mb-3">
                                <i class="bi bi-clock me-2" style="color: var(--p3);"></i>
                                <span>${loc.openingHour || '--'} - ${loc.closingHour || '--'}</span>
                                <span class="mx-2">•</span>
                                <i class="bi bi-hourglass-split me-2" style="color: var(--p3);"></i>
                                <span>${loc.avgDuration} mins</span>
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                ${loc.tags.map(t => `
                                    <span class="badge rounded-pill" style="background:${t.color}15; color:${t.color}; border:1px solid ${t.color}40; font-size:10px; font-weight: 600;">
                                        ${t.name}
                                    </span>
                                `).join('')}
                            </div>
                        </div>
                    </div>
                `).join('');
            } catch (e) { container.innerHTML = '<div class="text-danger small p-4 text-center">Error loading list.</div>'; }
        }

                async function deleteLocation(locationId) {
            // Custom SweetAlert2 Popup
            const result = await Swal.fire({
                title: 'Remove location?',
                text: "This will take it out of your itinerary.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#79B4A9', // Your --p3 color
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, remove it',
                cancelButtonText: 'Keep it',
                background: '#fcfdfa', // Match your card background
                color: '#4A503D',      // Match your --p5 color
                borderRadius: '1.5rem',
                customClass: {
                    popup: 'rounded-4 shadow-lg border-0'
                }
            });

            // If user clicked "Yes"
            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/Locations/DeleteLocation?id=${locationId}`, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (response.ok) {
                            await Swal.fire({
                            title: 'Removed!',
                            text: 'The location was removed from your trip.',
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false,
                            borderRadius: '1.5rem'
                        });
                        location.reload();
                    } else {
                        Swal.fire('Error', 'Could not delete the location.', 'error');
                    }
                } catch (e) {
                    console.error("Delete error:", e);
                }
            }
        }

        async function tryFetchHours(retries = 3) {
            const lat = document.getElementById('Latitude').value;
            const lon = document.getElementById('Longitude').value;
            const nameInput = document.getElementById('Name').value;
            const statusLabel = document.getElementById('osmStatus');

            if (!lat || !lon) return;

            statusLabel.innerText = "⏳ Syncing hours...";
            statusLabel.className = "text-muted small animate-pulse";

            const firstName = nameInput.split(' ')[0].replace(/[^\w\s]/gi, '');
            const query = `[out:json][timeout:15];(node["name"~"${firstName}",i](around:600,${lat},${lon});way["name"~"${firstName}",i](around:600,${lat},${lon});node(around:150,${lat},${lon})["opening_hours"];);out tags;`;

            try {
                const response = await fetch("https://overpass-api.de/api/interpreter?data=" + encodeURIComponent(query));
                if (!response.ok && retries > 0) {
                    await new Promise(res => setTimeout(res, 2000));
                    return tryFetchHours(retries - 1);
                }
                const data = await response.json();
                const element = data.elements.find(el => el.tags && el.tags.opening_hours);

                if (element) {
                    const rawHours = element.tags.opening_hours;
                    const match = rawHours.match(/([0-1]?\d|2[0-3]):([0-5]\d)\s?-\s?([0-1]?\d|2[0-3]):([0-5]\d)/);
                    if (match) setHoursUI(match[1].padStart(2, '0')+":"+match[2], match[3].padStart(2, '0')+":"+match[4], "✅ Hours synced", statusLabel);
                    else {
                        statusLabel.innerHTML = `<i class="bi bi-info-circle"></i> Check hours: ${rawHours}`;
                        statusLabel.className = "text-muted small";
                    }
                } else {
                    statusLabel.innerHTML = "<i class='bi bi-info-circle'></i> Hours not found. Add manually.";
                    statusLabel.className = "text-muted small";
                }
            } catch (e) {
                statusLabel.innerText = "Check hours manually.";
                statusLabel.className = "text-muted small";
            }
        }

        function setHoursUI(open, close, message, label) {
            document.getElementById('OpeningHour').value = open;
            document.getElementById('ClosingHour').value = close;
            label.innerHTML = `<span>${message}</span>`;
            label.className = "text-success fw-bold small";
        }

        function createSplitPin(colors) {
            const el = document.createElement('div');
            el.className = 'custom-marker';
            if (colors.length === 0) colors = ['#79B4A9'];
            const gradId = "grad_" + Math.random().toString(36).substr(2, 9);
            el.innerHTML = `
                <svg width="32" height="42" viewBox="0 0 32 42" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16 0C7.16344 0 0 7.16344 0 16C0 28 16 42 16 42C16 42 32 28 32 16C32 7.16344 24.8366 0 16 0Z" fill="white"/>
                    <path d="M16 2C8.26801 2 2 8.26801 2 16C2 25.5 16 38.5 16 38.5C16 38.5 30 25.5 30 16C30 8.26801 23.732 2 16 2Z" fill="url(#${gradId})"/>
                    <defs>
                        <linearGradient id="${gradId}" x1="0%" y1="0%" x2="100%" y2="100%">
                            ${colors.map((c, i) => `<stop offset="${(i / colors.length) * 100}%" stop-color="${c}" /><stop offset="${((i + 1) / colors.length) * 100}%" stop-color="${c}" />`).join('')}
                        </linearGradient>
                    </defs>
                    <circle cx="16" cy="16" r="6" fill="white" fill-opacity="0.5"/>
                </svg>`;
            return el;
        }

        async function loadExistingPins() {
            const tripId = "@Model.TripId";
            try {
                const response = await fetch(`/Locations/GetTripLocations?tripId=${tripId}`);
                const locations = await response.json();
                locations.forEach(loc => {
                    const tagColors = loc.tags.map(t => t.color).filter(c => c);
                    const tagHtml = loc.tags.map(t => `
                        <span class="badge rounded-pill" style="background:${t.color}22; color:${t.color}; border:1px solid ${t.color}; font-size:9px;">${t.name}</span>
                    `).join('');

                    new mapboxgl.Marker({ element: createSplitPin(tagColors) })
                        .setLngLat([loc.longitude, loc.latitude])
                        .setPopup(new mapboxgl.Popup({ offset: 25 })
                            .setHTML(`<div class="p-1"><strong>${loc.name}</strong><br><div class="mt-1 d-flex flex-wrap gap-1">${tagHtml}</div></div>`))
                        .addTo(map);
                });
            } catch (e) { console.error("Error loading existing pins:", e); }
        }
    </script>
}