@model Licenta.Models.Trip
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Trip Details";
}

<link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
<link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.css" type="text/css">

<style>
    /* ===============================
       CLEAN DETAILS CARD STYLING
    =============================== */
    .page-title {
        color: var(--p5);
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .details-container {
        width: 100%;
        max-width: 1800px;
        height: calc(100vh - 2rem); /* Fills almost the entire vertical screen */
        margin: 1rem auto;
    }

    .trip-card {
        background-color: #fcfdfa;
        border-radius: 1.2rem;
        box-shadow: 0 4px 15px rgba(103, 111, 84, 0.05);
        border: none;
        padding: 1.5rem;
        height: 100%; /* Fills the container */
        overflow: hidden; /* Prevents the whole card from scrolling */
    }

    .layout-row {
        height: 100%;
    }

    /* --- LEFT COLUMN (SCROLLABLE) --- */
    .left-column {
        height: 100%;
        overflow-y: auto; /* Adds the scrollbar ONLY to the left side */
        padding-right: 1.5rem;
        padding-left: 1rem;
    }

    /* Custom Scrollbar for Left Column */
    .left-column::-webkit-scrollbar {
        width: 6px;
    }
    .left-column::-webkit-scrollbar-track {
        background: transparent;
    }
    .left-column::-webkit-scrollbar-thumb {
        background: var(--p2);
        border-radius: 10px;
    }
    .left-column::-webkit-scrollbar-thumb:hover {
        background: var(--p3);
    }

    /* --- RIGHT COLUMN (MAP) --- */
    .right-column {
        height: 100%;
        padding-right: 1rem;
    }

    .map-container {
        width: 100%;
        height: 100%; /* Stretches map to match the full height of the card */
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(103, 111, 84, 0.05);
        border: 1px solid rgba(121, 180, 169, 0.2);
        background-color: #e9f8da;
    }

    .trip-card {
        background-color: #fcfdfa;
        border-radius: 1.2rem;
        box-shadow: 0 4px 15px rgba(103, 111, 84, 0.05);
        border: none;
        padding: 2.5rem;
    }

    .trip-title {
        color: var(--p5);
        font-weight: 800;
        font-size: 1.8rem;
        letter-spacing: -0.5px;
        margin-bottom: 1rem;
    }

    .trip-desc {
        color: #676f54;
        font-size: 1.05rem;
        line-height: 1.7;
        margin-bottom: 2.5rem;
    }

    

    #map {
        width: 100%;
        height: 100%;
    }

    /* Format unitar Iconiță + Text */
    .date-wrapper {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        color: var(--p5);
        font-weight: 500;
        font-size: 1rem;
        margin-bottom: 1rem;
    }

    .date-icon {
        color: var(--p4);
        font-size: 1.3rem;
        width: 25px;
        text-align: center;
    }

    .date-arrow {
        color: var(--p3);
        font-size: 0.85rem;
        margin: 0 0.2rem;
        opacity: 0.8;
    }

    .meta-info {
        font-size: 0.85rem;
        color: #8c947c;
        border-top: 1px solid rgba(121, 180, 169, 0.15);
        padding-top: 1.5rem;
        margin-top: 2.5rem;
    }

    /* --- SECTION TITLE --- */
    .section-title {
        color: var(--p4);
        font-weight: 700;
        font-size: 1.2rem;
        margin-bottom: 1rem;
        margin-top: 2rem;
    }

    /* --- TAGS DISPLAY --- */
    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 1.5rem;
    }

    .tag-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background-color: #ffffff;
        border: 1px solid rgba(121, 180, 169, 0.3);
        border-radius: 2rem;
        padding: 0.4rem 0.9rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--p5);
        transition: all 0.2s ease;
    }

    .tag-badge:hover {
        background-color: var(--p1);
        border-color: var(--p4);
    }

    .tag-color-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    /* --- EVENT/RESERVATION LIST STYLING --- */
    .event-card {
        background: #ffffff;
        border: 1px solid rgba(121, 180, 169, 0.2);
        border-radius: 0.8rem;
        padding: 1rem 1.2rem;
        margin-bottom: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: transform 0.2s ease;
    }

    .event-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(103, 111, 84, 0.08);
    }

    .event-info {
        flex-grow: 1;
    }

    .event-time {
        font-weight: 700;
        color: var(--p3);
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
    }

    .event-name {
        font-weight: 700;
        color: var(--p5);
        font-size: 1rem;
        margin-bottom: 0.25rem;
    }

    .event-location {
        font-size: 0.85rem;
        color: #8c947c;
    }

    .empty-state {
        text-align: center;
        padding: 2rem 1.5rem;
        background: var(--p1);
        border-radius: 0.8rem;
        border: 1px dashed rgba(121, 180, 169, 0.4);
    }

    .empty-state-icon {
        font-size: 2rem;
        color: var(--p3);
        opacity: 0.5;
        margin-bottom: 0.5rem;
    }

    .empty-state-text {
        color: #8c947c;
        margin: 0;
    }

    /* Buttons */
    .btn-back {
        color: var(--p5);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease;
    }

    .btn-back:hover {
        color: var(--p4);
        transform: translateX(-3px);
    }

    .btn-edit-large {
        background-color: var(--p4);
        color: white;
        border: none;
        border-radius: 0.5rem;
        padding: 0.6rem 1.5rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
    }

    .btn-edit-large:hover {
        background-color: var(--p3);
        color: var(--p5);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(121, 180, 169, 0.3);
    }

    /* --- GENERATE ITINERARY BUTTON --- */
    .btn-generate {
        background-color: var(--p4, #79b4a9);
        color: #ffffff;
        border: none;
        border-radius: 0.8rem;
        padding: 0.8rem 1rem; /* Slightly reduced padding so text fits */
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(121, 180, 169, 0.4);
        width: 100%;
    }

    .btn-generate:hover:not(:disabled) {
        background-color: var(--p5, #4A5D4E); /* Darkens on hover */
        color: #ffffff;
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(121, 180, 169, 0.5);
    }

    .btn-generate:active:not(:disabled) {
        transform: translateY(0);
        box-shadow: 0 4px 10px rgba(121, 180, 169, 0.3);
    }

    .btn-generate:disabled {
        background-color: #c4d4cc;
        cursor: not-allowed;
        box-shadow: none;
        opacity: 0.8;
    }

    .btn-generate i {
        font-size: 1.3rem;
        transition: transform 0.3s ease;
    }

    .btn-generate:hover:not(:disabled) i {
        transform: scale(1.1) rotate(5deg);
    }
    /* --- LOCATIONS HEADER & ADD BUTTON --- */
    .locations-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 2rem;
        margin-bottom: 1rem;
    }

    .locations-header .section-title {
        margin-top: 0; /* Override default top margin since flexbox handles it */
        margin-bottom: 0;
    }

    .btn-add-location {
        background-color: transparent;
        color: var(--p4, #79b4a9);
        border: 2px solid var(--p4, #79b4a9);
        border-radius: 2rem;
        padding: 0.35rem 1rem;
        font-size: 0.85rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
    }

    .btn-add-location:hover {
        background-color: var(--p4, #79b4a9);
        color: #ffffff;
        transform: translateY(-2px);
    }

    /* --- DROPDOWN TOGGLE BAR --- */
    .locations-dropdown-toggle {
        background-color: #f5f8f3; 
        border: 1px solid rgba(121, 180, 169, 0.3);
        color: var(--p5);
        font-weight: 600;
        border-radius: 0.8rem;
        padding: 0.8rem 1.2rem;
        width: 100%;
        text-align: left;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.2s ease;
        margin-bottom: 0.5rem;
        cursor: pointer;
    }

    .locations-dropdown-toggle:hover {
        background-color: #e9f0e6;
    }

    .locations-dropdown-toggle .bi-chevron-down {
        transition: transform 0.3s ease;
    }

    /* Rotates the arrow when the dropdown is open */
    .locations-dropdown-toggle[aria-expanded="true"] .bi-chevron-down {
        transform: rotate(180deg);
    }

    /* --- AI GENERATE BUTTON --- */
    .btn-ai {
        background: linear-gradient(135deg, #911eb4, #4363d8); 
        color: #ffffff;
        border: none;
        border-radius: 0.8rem;
        padding: 0.8rem 1rem; /* Slightly reduced padding so text fits */
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(145, 30, 180, 0.3);
        width: 100%;
    }

    .btn-ai:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(145, 30, 180, 0.4);
        color: white;
    }

    /* =========================================
   MAPBOX GEOCODER IN BOOTSTRAP MODAL FIX
   ========================================= */
#acc-geocoder-container {
    position: relative;
    z-index: 1060; /* Higher than the Bootstrap modal */
}

#acc-geocoder-container .mapboxgl-ctrl-geocoder {
    width: 100% !important;
    max-width: 100% !important;
    box-shadow: none !important;
    border: 1px solid #ced4da !important;
    border-radius: 0.375rem !important;
    background-color: #fff !important;
}

#acc-geocoder-container .mapboxgl-ctrl-geocoder--input {
    height: calc(2.5rem + 2px) !important;
    padding: 0.375rem 2.5rem !important;
    font-size: 1rem;
}

#acc-geocoder-container .mapboxgl-ctrl-geocoder .suggestions {
    z-index: 9999 !important; /* Forces dropdown over everything */
    top: 100% !important;
    border-radius: 0.375rem !important;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15) !important;
}

/* Prevent the modal from cutting off the dropdown */
#addAccommodationModal .modal-body {
    overflow: visible !important;
}
#addAccommodationModal .modal-content {
    overflow: visible !important;
}
</style>

<div class="details-container">
    <div class="trip-card">
        <div class="row g-4 layout-row">
            
            <!-- LEFT COLUMN: Details (Scrollable) -->
            <div class="col-lg-7 left-column order-2 order-lg-1 pb-4">
                
                <a asp-action="Index" class="btn-back mb-3 mt-2" style="font-size: 0.95rem; color: #8c947c;">
                    <i class="bi bi-arrow-left me-1"></i>Back to Trips
                </a>

                <h2 class="trip-title mt-1" style="font-size: 2.2rem;">@Model.Title</h2>

                <div class="trip-desc mb-4">
                    @Model.Description
                </div>

                <!-- TAGS SECTION -->
                @if (Model.Locations != null && Model.Locations.Any(l => l.LocationTags != null && l.LocationTags.Any()))
                {
                    <h3 class="section-title"><i class="bi bi-tags me-2"></i>Travel Interests</h3>
                    <div class="tags-container">
                        @{
                            var allTags = Model.Locations
                                .SelectMany(l => l.LocationTags ?? new List<LocationTag>())
                                .GroupBy(lt => lt.TagId)
                                .Select(g => g.First().Tag)
                                .Where(t => t != null) // 👈 ADD THIS: Ignores null tags
                                .Distinct()
                                .ToList();
                        }
                        @foreach (var tag in allTags)
                        {
                            <div class="tag-badge">
                                <div class="tag-color-dot" style="background-color: @tag.Color;"></div>
                                <span>@tag.Name</span>
                            </div>
                        }
                    </div>
                }

                <!-- ACCOMMODATION SECTION -->
                
                <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
    <h3 class="section-title m-0"><i class="bi bi-house-door-fill me-2"></i> Accommodation</h3>
</div>

@if (Model.Accommodation != null)
{
    <div class="card mb-4 border-0 shadow-sm" style="border-radius: 1rem; background: linear-gradient(135deg, #e9f8da, #f4f8f2);">
        <div class="card-body position-relative p-4">
            <h5 class="fw-bold text-dark mb-1">@Model.Accommodation.Name</h5>
            <p class="text-muted small mb-0"><i class="bi bi-geo-alt-fill me-1 text-danger"></i>@Model.Accommodation.Address</p>

            <div class="position-absolute top-0 end-0 p-3 d-flex gap-2">
                 <form asp-controller="Accommodations" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this accommodation?');" class="m-0">
                     <input type="hidden" name="id" value="@Model.Accommodation.AccommodationId" />
                     <input type="hidden" name="tripId" value="@Model.TripId" />
                     <button type="submit" class="btn btn-sm btn-light text-danger rounded-circle shadow-sm" title="Delete Accommodation">
                         <i class="bi bi-trash-fill"></i>
                     </button>
                 </form>
            </div>
        </div>
    </div>
}
else
{
    <div class="empty-state mb-4 py-3">
        <div class="empty-state-icon"><i class="bi bi-house-add"></i></div>
        <p class="empty-state-text mb-2">Where are you staying? Add your hotel or Airbnb.</p>
        <button type="button" class="btn btn-sm btn-outline-success rounded-pill fw-bold px-4 mt-2" data-bs-toggle="modal" data-bs-target="#addAccommodationModal">
            <i class="bi bi-plus-lg me-1"></i> Add Accommodation
        </button>
    </div>
}

<div class="modal fade" id="addAccommodationModal" tabindex="-1" aria-labelledby="addAccommodationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 1.2rem;">
            <div class="modal-header bg-light border-0" style="border-radius: 1.2rem 1.2rem 0 0;">
                <h5 class="modal-title fw-bold text-dark" id="addAccommodationModalLabel"><i class="bi bi-house-add-fill me-2" style="color: var(--p4);"></i>Add Accommodation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Accommodations" asp-action="CreateModal" method="post" id="accForm">
                <div class="modal-body p-4">
                    <input type="hidden" name="TripId" value="@Model.TripId" />

                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted small">Hotel/Airbnb Name</label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g., Marriott Downtown" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold text-muted small">Exact Address (Street & Number)</label>
                        <div id="acc-geocoder-container" class="w-100 border rounded"></div>
                        
                        <input type="hidden" id="acc-address" name="Address" required />
                        <input type="hidden" id="acc-lat" name="Latitude" />
                        <input type="hidden" id="acc-lng" name="Longitude" />
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light" style="border-radius: 0 0 1.2rem 1.2rem;">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white px-4" style="background-color: var(--p4); border-radius: 2rem;">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

                <!-- LOCATIONS SECTION -->
                <div class="locations-header">
                    <h3 class="section-title"><i class="bi bi-map-fill me-2"></i>Locations & Itinerary</h3>
                    
                    <!-- NOTE: Adjust asp-controller and asp-action to match your actual routing -->
                    <a asp-controller="Locations" asp-action="Add" asp-route-tripId="@Model.TripId" class="btn-add-location">
                        <i class="bi bi-plus-lg me-1"></i> Add More
                    </a>
                </div>

                @if (Model.Locations != null && Model.Locations.Any())
                {
                    <!-- Dropdown Toggle Button -->
                    <button class="locations-dropdown-toggle border-0" type="button" data-bs-toggle="collapse" data-bs-target="#locationsCollapse" aria-expanded="false" aria-controls="locationsCollapse">
                        <span><i class="bi bi-list-ul me-2"></i>View saved locations (@Model.Locations.Count())</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>

                    <!-- Collapsible List -->
                    <div class="collapse mb-4" id="locationsCollapse">
                        <div class="events-list pt-3">
                            @foreach (var loc in Model.Locations.OrderBy(l => l.OpeningHour ?? ""))
                            {
                                <div class="event-card">
                                    <div class="event-info">
                                        <div class="event-name">@loc.Name</div>
                                        @if (!string.IsNullOrEmpty(loc.OpeningHour))
                                        {
                                            <div class="event-time">
                                                <i class="bi bi-clock me-1"></i>
                                                @loc.OpeningHour
                                                @if (!string.IsNullOrEmpty(loc.ClosingHour))
                                                {
                                                    <span> - @loc.ClosingHour</span>
                                                }
                                            </div>
                                        }
                                        <div class="event-location">
                                            <i class="bi bi-hourglass-split me-1"></i> @loc.AvgDuration mins
                                            @if (loc.IsIndoor)
                                            {
                                                <span class="ms-2"><i class="bi bi-house-door-fill"></i> Indoor</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="empty-state mb-4">
                        <div class="empty-state-icon"><i class="bi bi-map-fill"></i></div>
                        <p class="empty-state-text">No locations added yet.</p>
                    </div>
                }
                
                <div class="row g-3 mt-2 mb-4">
                    <div class="col-md-4">
                        <form id="generateAiForm" asp-controller="Itinerary" asp-action="GenerateWithAI" method="post" class="h-100">
                            <input type="hidden" name="tripId" value="@Model.TripId" />
                            <button type="submit" id="generateAiBtn" class="btn-ai h-100 m-0 w-100" title="Automatically find and add the best locations">
                                <i class="bi bi-magic me-1"></i> Auto-Fill (AI)
                            </button>
                        </form>
                    </div>

                    <div class="col-md-8">
                        <form id="generateItineraryForm" asp-controller="Itinerary" asp-action="GenerateItinerary" method="post" class="h-100">
                            <input type="hidden" name="tripId" value="@Model.TripId" />
                            <button type="submit" id="generateBtn" class="btn-generate h-100 m-0 w-100">
                                <i class="bi bi-stars me-2"></i> Generate Daily Timeline
                            </button>
                        </form>
                    </div>
                </div>

                @{
                    var dayColors = new string[] { "#e6194B", "#3cb44b", "#4363d8", "#f58231", "#911eb4", "#42d4f4", "#f032e6", "#bfef45", "#fabed4", "#469990" };
                    int dayIndex = 0;
                }

                <h3 class="section-title"><i class="bi bi-calendar-check me-2"></i>Daily Itinerary</h3>

                @if (Model.DayPlans != null && Model.DayPlans.Any())
                {
                    @foreach (var day in Model.DayPlans.OrderBy(d => d.Date))
                    {
                        // Get the color for this specific day
                        string currentDayColor = dayColors[dayIndex % dayColors.Length];

                        <div class="card mb-4 border-0 shadow-sm" style="border-radius: 1rem; overflow: hidden; border-left: 5px solid @currentDayColor !important;">
                            <div class="card-header text-white py-3" style="background-color: @currentDayColor;">
                                <h5 class="mb-0" style="font-size: 1rem; font-weight: 700;">
                                    Day @((day.Date - Model.StartDate).Days + 1) — @day.Date.ToString("dd MMM yyyy")
                                </h5>
                            </div>
            
                            <ul class="list-group list-group-flush">
                                @foreach (var item in day.ItineraryItems.OrderBy(i => i.StartTime))
                                {
                                    bool isReservation = item.VisitStatus == "Reservation";
        
                                    <li class="list-group-item d-flex align-items-center py-3">
                                        <div class="me-3 text-center" style="min-width: 60px;">
                                            <span class="badge fw-bold" style="background-color: @currentDayColor; color: white; font-size: 0.9rem;">
                                                @item.StartTime.ToString(@"hh\:mm")
                                            </span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark">
                                                @if(isReservation) { <i class="bi bi-ticket-perforated-fill text-warning me-1"></i> }
                                                @(item.Location?.Name ?? "Unknown Location")
                                            </div>
                
                                            <small class="text-muted">
                                                @if (isReservation)
                                                {
                                                    <span><i class="bi bi-calendar-check text-warning me-1"></i> Reserved Ticket</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-hourglass-split"></i> @(item.Location?.AvgDuration ?? 0)<span> mins</span>
                                                    @if(item.Location?.IsIndoor == true) { <span class="ms-2"><i class="bi bi-house-door"></i> Indoor</span> }
                                                }
                                            </small>
                                        </div>
                                    </li>
                                }
    
                                @if(!day.ItineraryItems.Any())
                                {
                                    <li class="list-group-item text-muted text-center py-3">No locations scheduled for this day.</li>
                                }
                            </ul>
                        </div>
        
                        dayIndex++;
                    }
                }
                else
                {
                    <div class="empty-state">
                        <p class="empty-state-text">No schedule generated yet. Click the button above to organize your trip!</p>
                    </div>
                }

                <!-- RESERVATIONS/EVENTS SECTION -->
                <h3 class="section-title"><i class="bi bi-calendar-event me-2"></i>Reservations & Events</h3>
                @if (Model.Reservations != null && Model.Reservations.Any())
                {
                    <div class="events-list mb-4">
                        @foreach (var reservation in Model.Reservations.OrderBy(r => r.StartDate))
                        {
                            <div class="event-card">
                                <div class="event-info">
                                    <div class="event-name">@reservation.Name</div>
                                    <div class="event-time">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @reservation.StartDate.ToString("dd MMM yyyy HH:mm")
                                        <span> → </span>
                                        @reservation.EndDate.ToString("dd MMM yyyy HH:mm")
                                    </div>
                                    @if (!string.IsNullOrEmpty(reservation.Location?.Name))
                                    {
                                        <div class="event-location">
                                            <i class="bi bi-geo-alt me-1"></i>@reservation.Location?.Name
                                        </div>
                                    }
                                </div>
                                <form asp-controller="Reservations" asp-action="Delete" method="post" class="ms-3 m-0" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                    <input type="hidden" name="id" value="@reservation.ReservationId" />
                                    <!-- Passing TripId so the backend knows where to redirect back to -->
                                    <input type="hidden" name="tripId" value="@Model.TripId" />
                    
                                    <button type="submit" class="btn btn-link text-danger p-2 shadow-none border-0" style="opacity: 0.6; transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'" title="Delete Event">
                                        <i class="bi bi-x-lg fw-bold" style="font-size: 1.2rem;"></i>
                                    </button>
                                </form>

                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="bi bi-calendar-event"></i></div>
                        <p class="empty-state-text">No reservations or events added yet.</p>
                    </div>
                }

                <div class="row mt-5 pt-4 border-top" style="border-color: rgba(121, 180, 169, 0.15) !important;">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <div class="date-wrapper">
                            <i class="bi bi-clock date-icon"></i>
                            <span>@Model.StartExplorationHour - @Model.EndExplorationHour</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="date-wrapper">
                            <i class="bi bi-calendar3 date-icon"></i>
                            <span>@Model.StartDate.ToString("dd MMM yyyy")</span>
                            <i class="bi bi-arrow-right date-arrow"></i>
                            <span>@Model.EndDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>
                </div>

                <div class="meta-info d-flex justify-content-between align-items-center flex-wrap gap-3 mt-4">
                    <div>
                        <i class="bi bi-info-circle me-1"></i> Added on @Model.CreatedAt.ToString("dd MMM yyyy")
                    </div>

                    @if (Model.StartDate > DateTime.Now.Date)
                    {
                        <a asp-action="Edit" asp-route-id="@Model?.TripId" class="btn-edit-large">
                            <i class="bi bi-pencil-square me-2"></i>Edit Trip
                        </a>
                    }
                </div>

            </div>

            <!-- RIGHT COLUMN: Map (Static, fills remaining space) -->
            <div class="col-lg-5 right-column order-1 order-lg-2 mb-4 mb-lg-0">
                <div class="map-container">
                    <div id="map"></div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
    <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v5.0.0/mapbox-gl-geocoder.min.js"></script>

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        
        // --- 1. SET UP MAPBOX TOKEN (Needed for everything) ---
        const mapboxToken = '@Configuration["Mapbox:PublicKey"]';
        mapboxgl.accessToken = mapboxToken;

        // --- 2. AJAX FORM SUBMISSION ---
        const form = document.getElementById('generateItineraryForm');
        if (form) {
            form.addEventListener('submit', async function (e) {
                e.preventDefault(); 

                const btn = document.getElementById('generateBtn');
                const originalHtml = btn.innerHTML;
                
                btn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Generating...';
                btn.disabled = true;

                const formData = new FormData(this);

                try {
                    const response = await fetch(this.action, {
                        method: this.method,
                        body: formData
                    });

                    if (response.ok) {
                        const data = await response.json();
                        if (data.success) {
                            window.location.reload(); 
                        } else {
                            alert("Error: " + (data.message || "Could not generate itinerary."));
                            btn.innerHTML = originalHtml;
                            btn.disabled = false;
                        }
                    } else {
                        alert("Server error occurred while generating the itinerary.");
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                    }
                } catch (err) {
                    alert("A network error occurred.");
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            });
        }

        // --- AI FORM SUBMISSION ---
        const aiForm = document.getElementById('generateAiForm');
        if (aiForm) {
            aiForm.addEventListener('submit', async function (e) {
                e.preventDefault(); 
                const btn = document.getElementById('generateAiBtn');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Consulting AI...';
                btn.disabled = true;

                try {
                    const response = await fetch(this.action, { method: this.method, body: new FormData(this) });
                    const data = await response.json();
                    if (data.success) {
                        window.location.reload(); 
                    } else {
                        alert("AI Error: " + (data.message || "Could not generate."));
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                    }
                } catch (err) {
                    alert("A network error occurred.");
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            });
        }

        // --- 3. ACCOMMODATION MODAL GEOCODER (MOVED INSIDE!) ---
        const accModal = document.getElementById('addAccommodationModal');
        let accGeocoderInitialized = false;

        if (accModal) {
            accModal.addEventListener('shown.bs.modal', function () {
                if (!accGeocoderInitialized) {
                    const accGeocoder = new MapboxGeocoder({
                        accessToken: mapboxToken, // Now it can access the token!
                        types: 'address,poi', 
                        placeholder: 'Search for exact street or hotel...',
                        marker: false 
                    });

                    accGeocoder.addTo('#acc-geocoder-container');

                    accGeocoder.on('result', function(e) {
                        const result = e.result;
                        document.getElementById('acc-address').value = result.place_name;
                        document.getElementById('acc-lng').value = result.center[0];
                        document.getElementById('acc-lat').value = result.center[1];
                    });

                    accGeocoder.on('clear', function() {
                        document.getElementById('acc-address').value = "";
                        document.getElementById('acc-lng').value = "";
                        document.getElementById('acc-lat').value = "";
                    });

                    // Force 100% width inside the Bootstrap modal
                    const geocoderInputWrap = document.querySelector('#acc-geocoder-container .mapboxgl-ctrl-geocoder');
                    if(geocoderInputWrap) {
                        geocoderInputWrap.style.width = '100%';
                        geocoderInputWrap.style.maxWidth = '100%';
                        geocoderInputWrap.style.boxShadow = 'none';
                    }
                    
                    accGeocoderInitialized = true;
                }
            });

            document.getElementById('accForm').addEventListener('submit', function(e) {
                if (!document.getElementById('acc-address').value) {
                    e.preventDefault();
                    alert('Please select an exact address from the dropdown suggestions.');
                }
            });
        }

        // --- 4. MAPBOX LOGIC (MAIN PAGE MAP) ---
        const dayColors = ['#e6194B', '#3cb44b', '#4363d8', '#f58231', '#911eb4', '#42d4f4', '#f032e6', '#bfef45', '#fabed4', '#469990'];

        const itineraryDays = @Html.Raw(Json.Serialize(
            Model.DayPlans != null 
                ? Model.DayPlans.OrderBy(d => d.Date).Select(dp => new {
                    locations = dp.ItineraryItems.Where(i => i.Location != null).OrderBy(i => i.StartTime).Select(i => new {
                        name = i.Location.Name,
                        lat = i.Location.Latitude,
                        lng = i.Location.Longitude
                    }).ToList()
                }).ToList() 
                : new List<object>()
        ));

        const savedLocations = @Html.Raw(Json.Serialize(
            Model.Locations != null 
                ? Model.Locations.Select(l => new { name = l.Name, lat = l.Latitude, lng = l.Longitude }).ToList()
                : new List<object>()
        ));

        const accommodationData = @Html.Raw(Json.Serialize(
            Model.Accommodation != null 
                ? new { name = Model.Accommodation.Name, lat = Model.Accommodation.Latitude, lng = Model.Accommodation.Longitude }
                : null
        ));

        const map = new mapboxgl.Map({
            container: 'map',
            style: 'mapbox://styles/mapbox/streets-v12',
            center: [0, 0],
            zoom: 2
        });
        
        map.on('idle', () => { map.resize(); });
        map.addControl(new mapboxgl.NavigationControl(), 'top-right');

        const bounds = new mapboxgl.LngLatBounds();
        let hasPoints = false;

        // Draw Accommodation marker 
        if (accommodationData && accommodationData.lat !== 0 && accommodationData.lng !== 0) {
            hasPoints = true;

            const customMarkerEl = document.createElement('div');
            customMarkerEl.innerHTML = '<i class="bi bi-house-door-fill" style="color: white; font-size: 18px;"></i>';
            customMarkerEl.style.backgroundColor = '#911eb4'; 
            customMarkerEl.style.width = '36px';
            customMarkerEl.style.height = '36px';
            customMarkerEl.style.borderRadius = '50%';
            customMarkerEl.style.display = 'flex';
            customMarkerEl.style.alignItems = 'center';
            customMarkerEl.style.justifyContent = 'center';
            customMarkerEl.style.boxShadow = '0 4px 10px rgba(0,0,0,0.3)';
            customMarkerEl.style.border = '3px solid white';
            customMarkerEl.style.cursor = 'pointer';

            const popup = new mapboxgl.Popup({ offset: 25 })
                .setHTML(`<h6 style="margin:0; padding:5px; color:#911eb4;"><i class="bi bi-house-door-fill me-1"></i>${accommodationData.name}</h6><span style="font-size:0.8rem; padding-left:5px;">Accommodation</span>`);

            new mapboxgl.Marker({ element: customMarkerEl })
                .setLngLat([accommodationData.lng, accommodationData.lat])
                .setPopup(popup)
                .addTo(map);

            bounds.extend([accommodationData.lng, accommodationData.lat]);
        }

        // Draw Itinerary markers
        if (itineraryDays && itineraryDays.length > 0 && itineraryDays.some(d => d.locations.length > 0)) {
            itineraryDays.forEach((day, index) => {
                const color = dayColors[index % dayColors.length];
                const validLocations = day.locations.filter(loc => loc.lat !== 0 && loc.lng !== 0);

                validLocations.forEach(loc => {
                    hasPoints = true;
                    const popup = new mapboxgl.Popup({ offset: 25 })
                        .setHTML(`<h6 style="margin:0; padding:5px; color:${color};">Day ${index + 1}: ${loc.name}</h6>`);

                    new mapboxgl.Marker({ color: color })
                        .setLngLat([loc.lng, loc.lat])
                        .setPopup(popup)
                        .addTo(map);

                    bounds.extend([loc.lng, loc.lat]);
                });
            });

            if (hasPoints) map.fitBounds(bounds, { padding: 50, maxZoom: 14 });

            // 2. Draw ACTUAL street routes in a single 'load' event
            map.on('load', () => {
                itineraryDays.forEach(async (day, index) => {
                    const color = dayColors[index % dayColors.length];
                    
                    let validCoordinates = day.locations
                        .filter(loc => loc.lat !== 0 && loc.lng !== 0)
                        .map(loc => `${loc.lng},${loc.lat}`);

                    // Add the Accommodation to the START of the route
                    if (accommodationData && accommodationData.lat !== 0 && accommodationData.lng !== 0 && validCoordinates.length > 0) {
                        validCoordinates.unshift(`${accommodationData.lng},${accommodationData.lat}`);
                    }

                    if (validCoordinates.length > 1) {
                        // Max 25 waypoints per request for Mapbox Directions API
                        const coordsString = validCoordinates.slice(0, 25).join(';');
                        const profile = "walking"; 
                        
                        // 🌟 THE FIX: Notice the "&overview=full" added to this URL below!
                        const url = `https://api.mapbox.com/directions/v5/mapbox/${profile}/${coordsString}?geometries=geojson&overview=full&access_token=${mapboxToken}`;

                        try {
                            const response = await fetch(url);
                            const data = await response.json();

                            if (data.routes && data.routes.length > 0) {
                                const routeGeometry = data.routes[0].geometry;
                                const sourceId = `route-day-${index}`;
                                
                                map.addSource(sourceId, {
                                    'type': 'geojson',
                                    'data': {
                                        'type': 'Feature',
                                        'properties': {},
                                        'geometry': routeGeometry 
                                    }
                                });

                                map.addLayer({
                                    'id': sourceId,
                                    'type': 'line',
                                    'source': sourceId,
                                    'layout': {
                                        'line-join': 'round',
                                        'line-cap': 'round'
                                    },
                                    'paint': {
                                        'line-color': color,
                                        'line-width': 5, // Slightly thicker line looks great with full overview
                                        'line-opacity': 0.8 // Adds a nice slight transparency
                                    }
                                });
                            }
                        } catch (error) {
                            console.error(`Error fetching route for Day ${index + 1}:`, error);
                        }
                    }
                });
            });
        }
        else if (savedLocations && savedLocations.length > 0) {
            const validSavedLocations = savedLocations.filter(loc => loc.lat !== 0 && loc.lng !== 0);

            validSavedLocations.forEach(loc => {
                hasPoints = true;
                const popup = new mapboxgl.Popup({ offset: 25 })
                    .setHTML(`<h6 style="margin:0; padding:5px; color:#79B4A9;">${loc.name}</h6>`);

                new mapboxgl.Marker({ color: '#79B4A9' })
                    .setLngLat([loc.lng, loc.lat])
                    .setPopup(popup)
                    .addTo(map);

                bounds.extend([loc.lng, loc.lat]);
            });

            if (hasPoints) map.fitBounds(bounds, { padding: 50, maxZoom: 14 });
        } 
        else if (!hasPoints) {
            const locationQuery = encodeURIComponent('@Html.Raw(Model.City), @Html.Raw(Model.Country)');

            fetch(`https://api.mapbox.com/geocoding/v5/mapbox.places/${locationQuery}.json?access_token=${mapboxToken}&types=place,region,country`)
                .then(response => response.json())
                .then(data => {
                    if (data.features && data.features.length > 0) {
                        const coords = data.features[0].center; 
                        map.setCenter(coords);
                        map.setZoom(12);
                    }
                })
                .catch(error => console.error("Error loading map coordinates:", error));
        }
    }); // <--- DOMContentLoaded End Bracket
    </script>
}