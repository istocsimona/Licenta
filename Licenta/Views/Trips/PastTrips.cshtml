@model IEnumerable<Licenta.Models.Trip>

@{
    ViewData["Title"] = "Travel Memories";
}

<style>
    /* Add the base styles needed from your main page */
    .page-title {
        color: var(--p5);
        font-weight: 800;
        letter-spacing: -0.5px;
        font-size: 2rem;
    }

    .btn-outline-back {
        color: var(--p4);
        border: 2px solid var(--p4);
        border-radius: 1rem;
        padding: 0.6rem 1.2rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-outline-back:hover {
            background-color: var(--p1);
            color: var(--p5);
            transform: translateY(-2px);
        }

    .trip-card {
        background-color: #fcfdfa;
        border-radius: 1.5rem;
        box-shadow: 0 8px 20px rgba(103, 111, 84, 0.05);
        border: 2px solid transparent;
        transition: transform 0.3s, box-shadow 0.3s;
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 0.5rem;
        position: relative;
    }

        .trip-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(103, 111, 84, 0.12);
        }

    .card-past {
        opacity: 0.9;
        background-color: #fafaf9;
        border: 1px solid #e9ecef;
    }

        .card-past:hover {
            opacity: 1;
        }

    .trip-title {
        color: var(--p5);
        font-weight: 800;
        font-size: 1.4rem;
        letter-spacing: -0.3px;
    }

    .trip-desc {
        color: #8c947c;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .detail-group {
        margin-bottom: 0.8rem;
    }

    .date-wrapper {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--p5);
        font-weight: 600;
        font-size: 0.95rem;
        background-color: var(--p1);
        padding: 0.5rem 0.8rem;
        border-radius: 0.8rem;
    }

    .date-icon {
        color: var(--p4);
        font-size: 1.1rem;
    }

    .btn-plan {
        background-color: var(--p4);
        color: white;
        border-radius: 1rem;
        padding: 0.6rem 0.8rem;
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s;
        display: block;
        text-align: center;
        width: 100%;
    }

        .btn-plan:hover {
            background-color: var(--p5);
            color: white;
            transform: translateY(-2px);
        }

    .menu-dots {
        color: var(--p3);
        font-size: 1.4rem;
        transition: color 0.2s ease;
        padding: 0;
        opacity: 0.7;
    }

        .menu-dots:hover {
            opacity: 1;
            color: var(--p5);
        }

    .custom-dropdown {
        border-radius: 1rem;
        box-shadow: 0 8px 24px rgba(103, 111, 84, 0.15);
        border: none;
        padding: 0.5rem;
    }

        .custom-dropdown .dropdown-item {
            border-radius: 0.5rem;
            font-weight: 600;
            color: var(--p5);
            transition: background-color 0.2s;
        }

            .custom-dropdown .dropdown-item:hover {
                background-color: var(--p1);
            }

        .custom-dropdown .delete-item {
            color: #d9534f;
        }

            .custom-dropdown .delete-item:hover {
                background-color: #fdf2f2;
            }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="page-title mb-0"><i class="bi bi-camera-fill me-2" style="color: var(--p4);"></i> Travel Memories</h1>
        <a asp-action="Index" class="btn-outline-back">
            <i class="bi bi-arrow-left me-1"></i> Back to My Trips
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted mt-5">
            <i class="bi bi-image-alt" style="font-size: 3rem; color: var(--p2);"></i>
            <h4 class="mt-3">No past trips yet.</h4>
            <p>Your amazing travel memories will appear here.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="trip-card card-past">
                        <div class="p-4 flex-grow-1 d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h2 class="trip-title mb-0">@item.Title</h2>
                                <div class="dropdown">
                                    <button class="btn btn-link text-decoration-none menu-dots shadow-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end custom-dropdown">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.TripId"><i class="bi bi-list-task me-2"></i>Details</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item delete-item" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.TripId">
                                                <i class="bi bi-trash3 me-2"></i>Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div class="trip-desc">@item.Description</div>

                            <div class="row mt-auto align-items-center">
                                <div class="col-12 detail-group">
                                    <div class="date-wrapper">
                                        <i class="bi bi-pin-map-fill date-icon"></i>
                                        <span>@item.City, @item.Country</span>
                                    </div>
                                </div>

                                <div class="col-12 detail-group">
                                    <div class="date-wrapper">
                                        <i class="bi bi-calendar-heart date-icon"></i>
                                        <span>@item.StartDate.ToString("dd MMM yyyy") <i class="bi bi-arrow-right mx-1" style="opacity: 0.5;"></i> @item.EndDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>

                                <div class="col-12 mt-3">
                                    <a asp-action="Details" asp-route-id="@item.TripId" class="btn-plan w-100" style="background-color: var(--p1); color: var(--p5);">
                                        <i class="bi bi-journal-album me-1"></i> Relive the Memory
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="deleteModal-@item.TripId" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="border-radius: 1.5rem; border: none; box-shadow: 0 15px 35px rgba(103, 111, 84, 0.2);">
                            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                                <h5 class="modal-title page-title fs-4">Delete Memory</h5>
                                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body px-4">
                                <p class="text-muted">Are you sure you want to delete this trip memory? This action cannot be undone.</p>
                                <div class="p-3 mt-3" style="background-color: var(--p1); border-radius: 1rem;">
                                    <h6 style="color: var(--p5); font-weight: 800;">@item.Title</h6>
                                    <div class="text-muted" style="font-size: 0.9rem; font-weight: 600;">
                                        <div><i class="bi bi-pin-map-fill me-1 text-secondary"></i> @item.City, @item.Country</div>
                                        <div><i class="bi bi-calendar3 me-1 text-secondary"></i> @item.StartDate.ToString("dd MMM yyyy")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                                <form asp-action="Delete" method="post" class="w-100 d-flex justify-content-end gap-2 m-0">
                                    <input type="hidden" name="id" value="@item.TripId" />
                                    <button type="button" class="btn text-muted fw-bold bg-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4 shadow-sm">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>