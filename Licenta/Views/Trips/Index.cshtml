@model IEnumerable<Licenta.Models.Trip>

@{
    ViewData["Title"] = "My Trips";

    // 1. Determine the current date
    var today = DateTime.Now.Date;

    // 2. Filter and categorize trips
    var currentTrips = Model.Where(t => t.StartDate.Date <= today && t.EndDate.Date >= today).OrderBy(t => t.StartDate).ToList();
    var upcomingTrips = Model.Where(t => t.StartDate.Date > today).OrderBy(t => t.StartDate).ToList();

    // Get ALL past trips to count them, but take only the first 2 for the main view
    var allPastTrips = Model.Where(t => t.EndDate.Date < today).OrderByDescending(t => t.EndDate).ToList();
    var recentPastTrips = allPastTrips.Take(2).ToList();

    // 3. Create a structure to easily loop through the sections in the UI
    var tripSections = new[]
    {
        new { Title = "Happening Now", Trips = currentTrips, ShowPlan = true, Type = "current", HasMore = false },
        new { Title = "Upcoming Adventures", Trips = upcomingTrips, ShowPlan = true, Type = "upcoming", HasMore = false },
        new { Title = "Travel Memories", Trips = recentPastTrips, ShowPlan = false, Type = "past", HasMore = allPastTrips.Count > 2 }
    };
}

<style>
    /* ===============================
           CLEAN CARD & DROPDOWN STYLING
           =============================== */
    .page-title {
        color: var(--p5);
        font-weight: 800;
        letter-spacing: -0.5px;
        font-size: 2rem;
    }

    /* Section Headers */
    .section-title {
        color: var(--p4);
        font-weight: 800;
        font-size: 1.5rem;
        margin-top: 1rem;
        padding-bottom: 0.4rem;
        display: inline-block;
        border-bottom: 3px dashed var(--p1);
    }

    .btn-create {
        background: linear-gradient(135deg, var(--p4), var(--p3));
        color: white;
        border: none;
        border-radius: 1rem;
        padding: 0.7rem 1.4rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(121, 180, 169, 0.2);
    }

        .btn-create:hover {
            color: white;
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 8px 20px rgba(121, 180, 169, 0.4);
        }

    /* Base Trip Card Styles */
    .trip-card {
        background-color: #fcfdfa;
        border-radius: 1.5rem;
        box-shadow: 0 8px 20px rgba(103, 111, 84, 0.05);
        border: 2px solid transparent;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease, border 0.3s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 0.5rem;
        position: relative;
    }

        .trip-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(103, 111, 84, 0.12);
        }

    /* 🔥 SPECIAL STYLING: CURRENT TRIP 🔥 */
    .card-current {
        border: 2px solid var(--p3);
        background: linear-gradient(to bottom right, #ffffff, #f4f9f4);
        box-shadow: 0 10px 25px rgba(121, 180, 169, 0.2);
    }

    /* 📸 SPECIAL STYLING: PAST TRIP (MEMORIES) 📸 */
    .card-past {
        opacity: 0.9;
        background-color: #fafaf9;
        border: 1px solid #e9ecef;
    }

        .card-past:hover {
            opacity: 1;
        }

    .trip-title {
        color: var(--p5);
        font-weight: 800;
        font-size: 1.4rem;
        letter-spacing: -0.3px;
    }

    .trip-desc {
        color: #8c947c;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Format unitar Iconiță + Text */
    .detail-group {
        margin-bottom: 0.8rem;
    }

    .date-wrapper {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--p5);
        font-weight: 600;
        font-size: 0.95rem;
        background-color: var(--p1);
        padding: 0.5rem 0.8rem;
        border-radius: 0.8rem;
    }

    .date-icon {
        color: var(--p4);
        font-size: 1.1rem;
    }

    /* Buttons */
    .btn-plan {
        background-color: var(--p4);
        color: white;
        border-radius: 1rem;
        padding: 0.6rem 0.8rem;
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        display: block;
        text-align: center;
        width: 100%;
    }

        .btn-plan:hover {
            background-color: var(--p5);
            color: white;
            transform: translateY(-2px);
        }

    .btn-card-details {
        background-color: transparent;
        color: var(--p4);
        border: 2px solid var(--p4);
        border-radius: 1rem;
        padding: 0.5rem 0.8rem;
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        display: block;
        text-align: center;
        width: 100%;
    }

        .btn-card-details:hover {
            background-color: var(--p1);
            color: var(--p5);
            border-color: var(--p5);
            transform: translateY(-2px);
        }

    @@keyframes pulse {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(121, 180, 169, 0.7);
        }

        70% {
            transform: scale(1.05);
            box-shadow: 0 0 0 8px rgba(121, 180, 169, 0);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(121, 180, 169, 0);
        }
    }

    .badge-live {
        background-color: var(--p3);
        color: white;
        padding: 0.4rem 0.8rem;
        border-radius: 2rem;
        font-size: 0.85rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        animation: pulse 2s infinite;
        margin-bottom: 0.8rem;
        width: fit-content;
    }

    /* Dropdown Menus */
    .menu-dots {
        color: var(--p3);
        font-size: 1.4rem;
        transition: color 0.2s ease;
        padding: 0;
        opacity: 0.7;
    }

        .menu-dots:hover {
            opacity: 1;
            color: var(--p5);
        }

    .custom-dropdown {
        border-radius: 1rem;
        box-shadow: 0 8px 24px rgba(103, 111, 84, 0.15);
        border: none;
        padding: 0.5rem;
    }

        .custom-dropdown .dropdown-item {
            border-radius: 0.5rem;
            font-weight: 600;
            color: var(--p5);
            transition: background-color 0.2s;
        }

            .custom-dropdown .dropdown-item:hover {
                background-color: var(--p1);
            }

        .custom-dropdown .delete-item {
            color: #d9534f;
        }

            .custom-dropdown .delete-item:hover {
                background-color: #fdf2f2;
            }

    /* ===============================
           FLOATING TRIVIA WIDGET
           =============================== */
    .floating-trivia {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        width: 320px;
        z-index: 1050; /* Keeps it above the trips */
        background-color: #fdfdfc;
        border: 2px dashed var(--p3);
        border-radius: 1.5rem;
        box-shadow: 0 15px 35px rgba(103, 111, 84, 0.2);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        padding: 1.2rem;
    }

        .floating-trivia:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(103, 111, 84, 0.25);
        }

    /* Make it responsive for mobile phones */
    @@media (max-width: 768px) {
        .floating-trivia {
            bottom: 1rem;
            right: 1rem;
            width: calc(100% - 2rem);
        }
    }

    /* Collapsible Trivia Card Animations */
    .trivia-toggle {
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }

        .trivia-toggle:hover {
            opacity: 0.8;
        }

        .trivia-toggle .chevron {
            transition: transform 0.3s ease;
            color: var(--p3);
            font-weight: bold;
        }

        /* Rotates the arrow when the card is open */
        .trivia-toggle[aria-expanded="true"] .chevron {
            transform: rotate(180deg);
        }

    .btn-reveal {
        background-color: var(--p1);
        color: var(--p4);
        border: none;
        border-radius: 1rem;
        padding: 0.6rem 0.8rem;
        font-weight: 800;
        width: 100%;
        transition: all 0.2s;
    }

        .btn-reveal:hover {
            background-color: var(--p3);
            color: white;
        }

    .btn-see-all {
        color: var(--p4);
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        padding: 0.4rem 1rem;
        border-radius: 2rem;
        background-color: var(--p1);
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

        .btn-see-all:hover {
            background-color: var(--p3);
            color: white;
            transform: translateX(4px);
        }
</style>

<div class="row mt-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="page-title mb-0">My Trips</h1>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show position-absolute top-0 start-50 translate-middle-x mt-3 shadow" style="z-index: 1050; border-radius: 1rem;" role="alert">
                    <strong>Oops!</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show position-absolute top-0 start-50 translate-middle-x mt-3 shadow" style="z-index: 1050; border-radius: 1rem;" role="alert">
                    <strong>Yay!</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <a asp-action="Create" class="btn-create">
                <i class="bi bi-airplane-fill me-2"></i> Plan New Trip
            </a>
        </div>

        @foreach (var tripCategory in tripSections)
        {
            @if (tripCategory.Trips.Any())
            {
                <h3 class="section-title mb-4">@tripCategory.Title</h3>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3  g-4 mb-5">
                    @foreach (var item in tripCategory.Trips)
                    {
                        <div class="col">
                            <div class="trip-card @(tripCategory.Type == "current" ? "card-current" : tripCategory.Type == "past" ? "card-past" : "")">
                                <div class="p-4 flex-grow-1 d-flex flex-column">

                                    @if (tripCategory.Type == "current")
                                    {
                                        var currentDay = (today - item.StartDate.Date).Days + 1;
                                        var totalDays = (item.EndDate.Date - item.StartDate.Date).Days + 1;
                                        <div class="badge-live">
                                            <i class="bi bi-geo-alt-fill"></i> Day @currentDay of @totalDays
                                        </div>
                                    }

                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h2 class="trip-title mb-0">@item.Title</h2>
                                        <div class="dropdown">
                                            <button class="btn btn-link text-decoration-none menu-dots shadow-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-three-dots"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end custom-dropdown">
                                                <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.TripId"><i class="bi bi-list-task me-2"></i>Details</a></li>
                                                @if (item.StartDate > today)
                                                {
                                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.TripId"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                                }
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item delete-item" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.TripId">
                                                        <i class="bi bi-trash3 me-2"></i>Delete
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div class="trip-desc">@item.Description</div>

                                    <div class="row mt-auto align-items-center">
                                        <div class="col-12 detail-group">
                                            <div class="date-wrapper">
                                                <i class="bi bi-pin-map-fill date-icon"></i>
                                                <span>@item.City, @item.Country</span>
                                            </div>
                                        </div>

                                        <div class="col-12 detail-group">
                                            <div class="date-wrapper">
                                                <i class="bi bi-calendar-heart date-icon"></i>
                                                <span>@item.StartDate.ToString("dd MMM yyyy") <i class="bi bi-arrow-right mx-1" style="opacity: 0.5;"></i> @item.EndDate.ToString("dd MMM yyyy")</span>
                                            </div>
                                        </div>

                                        @if (tripCategory.ShowPlan)
                                        {
                                            <div class="col-12 mt-3">
                                                <div class="row g-2">
                                                    <div class="col-6">
                                                        <a asp-controller="Locations" asp-action="Add" asp-route-tripId="@item.TripId" class="btn-plan">
                                                            <i class="bi bi-plus-circle me-1"></i> Locations
                                                        </a>
                                                    </div>
                                                    <div class="col-6">
                                                        <a asp-action="Details" asp-route-id="@item.TripId" class="btn-card-details">
                                                            Itinerary <i class="bi bi-arrow-right-short"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-12 mt-3">
                                                <a asp-action="Details" asp-route-id="@item.TripId" class="btn-plan w-100" style="background-color: var(--p1); color: var(--p5);">
                                                    <i class="bi bi-journal-album me-1"></i> Relive the Memory
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="deleteModal-@item.TripId" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content" style="border-radius: 1.5rem; border: none; box-shadow: 0 15px 35px rgba(103, 111, 84, 0.2);">
                                    <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                                        <h5 class="modal-title page-title fs-4">Delete Trip</h5>
                                        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body px-4">
                                        <p class="text-muted">Are you sure you want to delete this trip? This action cannot be undone.</p>
                                        <div class="p-3 mt-3" style="background-color: var(--p1); border-radius: 1rem;">
                                            <h6 style="color: var(--p5); font-weight: 800;">@item.Title</h6>
                                            <div class="text-muted" style="font-size: 0.9rem; font-weight: 600;">
                                                <div><i class="bi bi-pin-map-fill me-1 text-secondary"></i> @item.City, @item.Country</div>
                                                <div><i class="bi bi-calendar3 me-1 text-secondary"></i> @item.StartDate.ToString("dd MMM yyyy")</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                                        <form asp-action="Delete" method="post" class="w-100 d-flex justify-content-end gap-2 m-0">
                                            <input type="hidden" name="id" value="@item.TripId" />
                                            <button type="button" class="btn text-muted fw-bold bg-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4 shadow-sm">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (tripCategory.HasMore)
                {
                    <div class="text-center mb-5">
                        <a asp-action="PastTrips" class="btn-card-details d-inline-block w-auto px-5 py-2">
                            See all past trips <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div class="mb-5"></div>
                }
            }
        }
    </div>

</div>

<div class="floating-trivia">
    <div class="trivia-toggle d-flex justify-content-between align-items-center"
         data-bs-toggle="collapse"
         data-bs-target="#triviaContent"
         aria-expanded="false"
         aria-controls="triviaContent">
        <h4 class="mb-0" style="color: var(--p4); font-weight: 900; font-size: 1.2rem;">
            <i class="bi bi-patch-question-fill me-1" style="color: #ffc107;"></i>
            Trivia Time!
        </h4>
        <i class="bi bi-chevron-down chevron"></i>
    </div>

    <div class="collapse" id="triviaContent">
        <div class="pt-4">
            <p style="color: var(--p5); font-weight: 700; font-size: 1rem; line-height: 1.4;">
                @ViewBag.TriviaQuestion
            </p>

            @if (ViewBag.TriviaOptions != null)
            {
                <ul style="list-style-type: none; padding-left: 0; margin-bottom: 1.5rem;">
                    @foreach (var option in (List<string>)ViewBag.TriviaOptions)
                    {
                        <li style="background-color: var(--p1); padding: 0.5rem 1rem; border-radius: 0.8rem; margin-bottom: 0.5rem; font-weight: 600; font-size: 0.9rem; color: var(--p5);">
                            @option
                        </li>
                    }
                </ul>
            }

            @if (!string.IsNullOrEmpty(ViewBag.TriviaAnswer))
            {
                <div style="margin-top: 0.5rem;">
                    <button class="btn-reveal shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#triviaAnswer">
                        <i class="bi bi-stars me-1"></i> Reveal Answer
                    </button>
                    <div class="collapse mt-3" id="triviaAnswer">
                        <div class="text-center p-3" style="background-color: #e9f0e6; border-radius: 1rem;">
                            <p class="mb-0" style="font-weight: 900; color: var(--p5); font-size: 1.1rem;">
                                @ViewBag.TriviaAnswer
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const triviaContent = document.getElementById('triviaContent');
            let collapseTimeout;

            if (triviaContent) {
                triviaContent.addEventListener('shown.bs.collapse', function () {

                    clearTimeout(collapseTimeout);

                    // Set a timer for 1 minute (60000 ms)
                    collapseTimeout = setTimeout(function () {
                        // Find the bootstrap collapse instance and hide it
                        let bsCollapse = bootstrap.Collapse.getInstance(triviaContent);
                        if (bsCollapse) {
                            bsCollapse.hide();
                        }
                    }, 60000);
                });

                triviaContent.addEventListener('hidden.bs.collapse', function () {
                    clearTimeout(collapseTimeout);
                });
            }
        });
    </script>
}