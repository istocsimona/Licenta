@model IEnumerable<Licenta.Models.Trip>

@{
    ViewData["Title"] = "My Trips";

    // 1. Determine the current date
    var today = DateTime.Now.Date;

    // 2. Filter and categorize trips
    var currentTrips = Model.Where(t => t.StartDate.Date <= today && t.EndDate.Date >= today).OrderBy(t => t.StartDate).ToList();
    var upcomingTrips = Model.Where(t => t.StartDate.Date > today).OrderBy(t => t.StartDate).ToList();
    var pastTrips = Model.Where(t => t.EndDate.Date < today).OrderByDescending(t => t.EndDate).ToList();

    // 3. Create a structure to easily loop through the sections in the UI
    var tripSections = new[]
    {
        new { Title = "Current Trips", Trips = currentTrips, ShowPlan = true },
        new { Title = "Upcoming Trips", Trips = upcomingTrips, ShowPlan = true },
        new { Title = "Past Trips", Trips = pastTrips, ShowPlan = false }
    };
}

<style>
    /* ===============================
       CLEAN CARD & DROPDOWN STYLING
       =============================== */
    .page-title {
        color: var(--p5);
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    /* Section Headers */
    .section-title {
        color: var(--p4);
        font-weight: 800;
        font-size: 1.4rem;
        margin-top: 1rem;
        border-bottom: 2px solid var(--p1);
        padding-bottom: 0.4rem;
        display: inline-block;
    }

    .btn-create {
        background-color: var(--p4);
        color: white;
        border: none;
        border-radius: 0.5rem;
        padding: 0.6rem 1.2rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-create:hover {
            background-color: var(--p3);
            color: var(--p5);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(121, 180, 169, 0.3);
        }

    /* Clean Trip Card Styles */
    .trip-card {
        background-color: #fcfdfa;
        border-radius: 1.2rem;
        box-shadow: 0 4px 15px rgba(103, 111, 84, 0.05);
        border: none;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 0.5rem;
    }

        .trip-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(103, 111, 84, 0.1);
        }

    .trip-title {
        color: var(--p5);
        font-weight: 800;
        font-size: 1.35rem;
        letter-spacing: -0.3px;
    }

    .trip-desc {
        color: #8c947c;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 2rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Grid for trip details */
    .detail-group {
        margin-bottom: 0.8rem;
    }

    /* Format unitar Iconiță + Text */
    .date-wrapper {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--p5);
        font-weight: 500;
        font-size: 0.95rem;
    }

    .date-icon {
        color: var(--p3);
        font-size: 1.1rem;
        width: 20px;
        text-align: center;
    }

    .date-arrow {
        color: var(--p3);
        font-size: 0.8rem;
        margin: 0 0.1rem;
        opacity: 0.7;
    }

    /* Plan Button */
    .btn-plan {
        background-color: var(--p1);
        color: var(--p5);
        border: 1px solid var(--p3);
        border-radius: 0.8rem;
        padding: 0.6rem 0.8rem;
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        display: block;
        text-align: center;
        width: 100%;
    }

        .btn-plan:hover {
            background-color: var(--p3);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(121, 180, 169, 0.2);
        }

    /* 3-Dots Menu */
    .menu-dots {
        color: var(--p3);
        font-size: 1.2rem;
        transition: color 0.2s ease;
        padding: 0;
        opacity: 0.8;
    }

        .menu-dots:hover, .menu-dots:focus {
            color: var(--p5);
            opacity: 1;
        }

    .custom-dropdown {
        border: none;
        border-radius: 0.8rem;
        box-shadow: 0 8px 24px rgba(103, 111, 84, 0.12);
        padding: 0.5rem 0;
    }

        .custom-dropdown .dropdown-item {
            font-weight: 500;
            color: var(--p5);
            padding: 0.6rem 1.2rem;
            transition: background-color 0.2s ease;
        }

            .custom-dropdown .dropdown-item:hover {
                background-color: var(--p1);
                color: var(--p5);
            }

        .custom-dropdown .delete-item {
            color: #d9534f;
        }

            .custom-dropdown .delete-item:hover {
                background-color: #fdf2f2;
                color: #d9534f;
            }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h1 class="page-title mb-0">My Trips</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            <strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <a asp-action="Create" class="btn-create">
        <i class="bi bi-plus-lg me-2"></i>Create New Trip
    </a>
</div>

@* Iterate through our categorized sections *@
@* Iterate through our categorized sections using 'tripCategory' to avoid Razor keyword conflicts *@
@foreach (var tripCategory in tripSections)
{
    @if (tripCategory.Trips.Any())
    {
        <h3 class="section-title mb-4">@tripCategory.Title</h3>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var item in tripCategory.Trips)
            {
                <div class="col">
                    <div class="trip-card">

                        <div class="p-4 flex-grow-1 d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h2 class="trip-title mb-0">@item.Title</h2>

                                <div class="dropdown">
                                    <button class="btn btn-link text-decoration-none menu-dots shadow-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end custom-dropdown">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.TripId">Details</a></li>

                                        @if (item.StartDate > today)
                                        {
                                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.TripId">Edit</a></li>
                                        }

                                        <li>
                                            <a class="dropdown-item delete-item" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.TripId">
                                                Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div class="trip-desc">
                                @item.Description
                            </div>

                            <div class="row mt-auto align-items-center">
                                <div class="col-12 detail-group">
                                    <div class="date-wrapper">
                                        <i class="bi bi-geo-alt-fill date-icon"></i>
                                        <span>@item.City, @item.Country</span>
                                    </div>
                                </div>

                                <div class="col-12 detail-group">
                                    <div class="date-wrapper">
                                        <i class="bi bi-calendar3 date-icon"></i>
                                        <span>@item.StartDate.ToString("dd MMM yyyy")</span>
                                        <i class="bi bi-arrow-right date-arrow"></i>
                                        <span>@item.EndDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>

                                <!-- Conditionally show the Plan Button based on the category settings -->
                                @if (tripCategory.ShowPlan)
                                {
                                    <div class="col-12 mt-4">
                                        <a asp-controller="Locations" asp-action="Add" asp-route-tripId="@item.TripId" class="btn-plan">
                                            <i class="bi bi-map me-2"></i> Plan
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <!-- A nice subtle visual indicator for past trips instead of a button -->
                                    <div class="col-12 mt-4 text-center">
                                        <span style="font-size: 0.85rem; font-weight: 600; color: #8c947c; padding: 0.4rem 1rem; background-color: var(--p1); border-radius: 1rem;">
                                            <i class="bi bi-check2-circle me-1"></i> Completed
                                        </span>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Delete Trip Modal -->
                <div class="modal fade" id="deleteModal-@item.TripId" tabindex="-1" aria-labelledby="deleteModalLabel-@item.TripId" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="border-radius: 1.2rem; background-color: #fcfdfa; border: none; box-shadow: 0 15px 35px rgba(103, 111, 84, 0.2);">

                            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                                <h5 class="modal-title page-title" id="deleteModalLabel-@item.TripId">Delete Trip</h5>
                                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <div class="modal-body px-4">
                                <p style="color: #7a8268; font-size: 0.95rem;">Are you sure you want to delete this trip? This action cannot be undone.</p>

                                <div class="p-3 mt-3" style="background-color: var(--p1); border-radius: 0.8rem; opacity: 0.9;">
                                    <h6 style="color: var(--p5); font-weight: 700; margin-bottom: 0.5rem;">@item.Title</h6>
                                    <div style="font-size: 0.85rem; color: var(--p5); font-weight: 500;">
                                        <div class="mb-1"><i class="bi bi-geo-alt-fill me-1" style="color: var(--p4);"></i> @item.City, @item.Country</div>
                                        <div class="mb-1"><i class="bi bi-calendar3 me-1" style="color: var(--p4);"></i> @item.StartDate.ToString("dd MMM yyyy") - @item.EndDate.ToString("dd MMM yyyy")</div>
                                        <div><i class="bi bi-clock me-1" style="color: var(--p4);"></i> @item.StartExplorationHour - @item.EndExplorationHour</div>
                                    </div>
                                </div>
                            </div>

                            <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                                <form asp-action="Delete" method="post" class="w-100 d-flex justify-content-end gap-2 m-0">
                                    <input type="hidden" name="id" value="@item.TripId" />

                                    <button type="button" class="btn" data-bs-dismiss="modal" style="border-radius: 0.5rem; font-weight: 600; color: var(--p5); background-color: #e9f8da;">
                                        Cancel
                                    </button>
                                    <button type="submit" class="btn" style="border-radius: 0.5rem; font-weight: 600; background-color: #d9534f; color: white;">
                                        Delete Trip
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
}